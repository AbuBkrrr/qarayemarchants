---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Forgot Password - Qaraye Marchants">
  <div class="container" style="padding: 60px 24px; max-width: 460px;">

    <a href="/login" style="font-family: var(--mono); font-size: 12px; color: var(--ink-muted); text-decoration: none; display: inline-flex; align-items: center; gap: 6px; margin-bottom: 24px;">&larr; Back to Sign In</a>

    <h1 style="font-family: var(--display); font-size: 2rem; margin: 0 0 8px 0; color: var(--ink);">Reset Password</h1>
    <p style="color: var(--ink-muted); margin-bottom: 32px;">Enter your email or phone number. We'll help you recover access.</p>

    <form id="forgot-form" style="display: flex; flex-direction: column; gap: 16px;">
      <div>
        <label for="identifier" style="display: block; font-family: var(--mono); font-size: 12px; margin-bottom: 6px; color: var(--ink-muted);">EMAIL OR PHONE</label>
        <input type="text" id="identifier" required autocomplete="username" placeholder="you@example.com or 0803 123 4567"
               style="width: 100%; padding: 12px; background: var(--bg-850); border: 1px solid var(--line-soft); border-radius: var(--r-sm); color: var(--ink); font-family: var(--body);">
      </div>

      <button type="submit" class="btn btn-primary" style="padding: 14px;">Send Reset Link</button>
    </form>

    <div id="status-box" style="display: none; margin-top: 24px; padding: 18px; border-radius: var(--r-md); border: 1px solid var(--line-soft); background: var(--bg-850);">
      <p id="status-text" style="margin: 0; font-size: 0.92rem; line-height: 1.6;"></p>
      <div id="status-actions" style="margin-top: 14px; display: none;">
        <a id="whatsapp-cta" href="#" target="_blank" rel="noopener" class="btn btn-primary" style="display: inline-flex; padding: 10px 20px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Contact Admin on WhatsApp
        </a>
      </div>
    </div>

    <div style="margin-top: 32px; padding: 18px; background: var(--bg-850); border: 1px dashed var(--line-soft); border-radius: var(--r-md);">
      <p style="font-family: var(--mono); font-size: 11.5px; color: var(--ink-muted); margin: 0 0 8px 0; line-height: 1.6;">
        <strong style="color: var(--ink);">How this works:</strong>
      </p>
      <ul style="font-family: var(--mono); font-size: 11px; color: var(--ink-faint); margin: 0; padding-left: 16px; line-height: 1.8;">
        <li>If you signed up with email → reset link sent to your inbox</li>
        <li>If you signed up with phone only → contact admin via WhatsApp for manual reset</li>
      </ul>
    </div>

  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';
  import { ADMIN_WHATSAPP } from '../config';

  const form = document.getElementById('forgot-form') as HTMLFormElement;
  const statusBox = document.getElementById('status-box')!;
  const statusText = document.getElementById('status-text')!;
  const statusActions = document.getElementById('status-actions')!;
  const whatsappCta = document.getElementById('whatsapp-cta') as HTMLAnchorElement;
  const identifier = document.getElementById('identifier') as HTMLInputElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    statusBox.style.display = 'block';
    statusActions.style.display = 'none';
    statusText.textContent = 'Processing...';
    statusText.style.color = 'var(--ink-muted)';

    const raw = identifier.value.trim();
    if (!raw) return;

    // Determine if email or phone
    const isEmail = raw.includes('@');
    const isPhone = /^\+?[0-9\s\-()]{7,}$/.test(raw);
    const digits = raw.replace(/[^0-9]/g, '');

    if (isEmail) {
      // Real email → send reset link via Supabase
      const { error } = await supabase.auth.resetPasswordForEmail(raw, {
        redirectTo: 'https://qarayemarchants.com.ng/reset-password'
      });

      if (error) {
        statusText.textContent = 'Error: ' + error.message;
        statusText.style.color = 'var(--red)';
        return;
      }

      statusText.innerHTML = '<strong style="color: var(--green);">Check your inbox.</strong><br>A password reset link has been sent to <strong>' + escapeHtml(raw) + '</strong>. The link expires in 1 hour.';
      statusText.style.color = 'var(--ink)';
    } else if (isPhone) {
      // Phone-only signup → no email available → contact admin
      const message = `Hello Qaraye Marchants Admin, I need help resetting my password.\n\nMy phone number on file: ${digits}\n\nPlease assist with a manual password reset.`;
      whatsappCta.href = 'https://wa.me/' + ADMIN_WHATSAPP + '?text=' + encodeURIComponent(message);
      statusActions.style.display = 'block';
      statusText.innerHTML = '<strong style="color: var(--amber);">Phone-based account detected.</strong><br>Because this account was created with a phone number only, we cannot send an automated reset email. Please contact our admin team on WhatsApp — they will verify your identity and reset your password manually.';
      statusText.style.color = 'var(--ink)';
    } else {
      statusText.textContent = 'Please enter a valid email or phone number.';
      statusText.style.color = 'var(--red)';
    }
  });

  function escapeHtml(s: string) {
    return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  }
</script>