---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Forgot Password - Qaraye Marchants">
  <div class="container" style="padding: 60px 24px; max-width: 460px;">

    <a href="/login" style="font-family: var(--mono); font-size: 12px; color: var(--ink-muted); text-decoration: none; display: inline-flex; align-items: center; gap: 6px; margin-bottom: 24px;">&larr; Back to Sign In</a>

    <h1 style="font-family: var(--display); font-size: 2rem; margin: 0 0 8px 0; color: var(--ink);">Reset Password</h1>
    <p style="color: var(--ink-muted); margin-bottom: 32px;">We will send a 6-digit code to your email. Enter it on the next page to set a new password.</p>

    <form id="forgot-form" style="display: flex; flex-direction: column; gap: 16px;">
      <div>
        <label for="email" style="display: block; font-family: var(--mono); font-size: 12px; margin-bottom: 6px; color: var(--ink-muted);">EMAIL</label>
        <input type="email" id="email" required autocomplete="email" placeholder="you@example.com"
               style="width: 100%; padding: 12px; background: var(--bg-850); border: 1px solid var(--line-soft); border-radius: var(--r-sm); color: var(--ink); font-family: var(--body);">
      </div>

      <button type="submit" class="btn btn-primary" style="padding: 14px;">Send Reset Code</button>
    </form>

    <div id="status-box" style="display: none; margin-top: 24px; padding: 18px; border-radius: var(--r-md); border: 1px solid var(--line-soft); background: var(--bg-850);">
      <p id="status-text" style="margin: 0; font-size: 0.92rem; line-height: 1.6;"></p>
    </div>

    <div style="margin-top: 32px; padding: 18px; background: var(--bg-850); border: 1px dashed var(--line-soft); border-radius: var(--r-md);">
      <p style="font-family: var(--mono); font-size: 11.5px; color: var(--ink-muted); margin: 0 0 8px 0; line-height: 1.6;">
        <strong style="color: var(--ink);">How this works:</strong>
      </p>
      <ul style="font-family: var(--mono); font-size: 11px; color: var(--ink-faint); margin: 0; padding-left: 16px; line-height: 1.8;">
        <li>Enter the email on your Qaraye Marchants account</li>
        <li>We send you a 6-digit code (no links to click)</li>
        <li>Enter the code + your new password on the next page</li>
      </ul>
    </div>

  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('forgot-form') as HTMLFormElement;
  const statusBox = document.getElementById('status-box')!;
  const statusText = document.getElementById('status-text')!;
  const emailInput = document.getElementById('email') as HTMLInputElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    statusBox.style.display = 'block';
    statusText.textContent = 'Sending...';
    statusText.style.color = 'var(--ink-muted)';

    const email = emailInput.value.trim().toLowerCase();
    if (!email || !email.includes('@')) {
      statusText.textContent = 'Please enter a valid email address.';
      statusText.style.color = 'var(--red)';
      return;
    }

    const { error } = await supabase.auth.resetPasswordForEmail(email);

    if (error) {
      statusText.textContent = 'Error: ' + error.message;
      statusText.style.color = 'var(--red)';
      return;
    }

    // Record send time so verify page can show countdown
    sessionStorage.setItem('qm-otp-sent-at', String(Date.now()));

    statusText.innerHTML = '<strong style="color: var(--green);">Code sent.</strong><br>Check <strong>' + escapeHtml(email) + '</strong> for your reset code. Redirecting...';
    statusText.style.color = 'var(--ink)';

    setTimeout(() => {
      window.location.href = '/verify-otp?email=' + encodeURIComponent(email);
    }, 1200);
  });

  function escapeHtml(s: string) {
    return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  }
</script>