---
import Layout from '../../layouts/Layout.astro';
import Comments from '../../components/Comments.astro';
import { supabase } from '../../lib/supabase';
import { createSupabaseServerClient } from '../../lib/auth';

const { id } = Astro.params;
if (!id) return Astro.redirect('/');

const { data: post } = await supabase
  .from('qm_posts')
  .select('id,title,body,media_url,media_thumbnail_url,media_type,created_at,user_id')
  .eq('id', id)
  .maybeSingle();

if (!post) return Astro.redirect('/');

const { data: author } = await supabase
  .from('profiles')
  .select('display_name')
  .eq('id', post.user_id)
  .maybeSingle();

// Fetch comments
const { data: rawComments } = await supabase
  .from('qm_comments')
  .select('id,body,created_at,user_id')
  .eq('post_id', id)
  .order('created_at', { ascending: true });

// Fetch profiles for commenters
const userIds = [...new Set((rawComments ?? []).map((c) => c.user_id))];
const profileMap: Record<string, string> = {};
if (userIds.length > 0) {
  const { data: profiles } = await supabase
    .from('profiles')
    .select('id,display_name')
    .in('id', userIds);
  if (profiles) for (const p of profiles) profileMap[p.id] = p.display_name;
}

const comments = (rawComments ?? []).map((c) => ({
  ...c,
  profiles: c.user_id && profileMap[c.user_id] ? { display_name: profileMap[c.user_id] } : null,
}));

const authClient = createSupabaseServerClient(Astro.cookies);
const { data: { user } } = await authClient.auth.getUser();

const authorName = author?.display_name ?? 'Anonymous';
const dateStr = new Date(post.created_at).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title={post.title + ' | Qaraye Marchants'}>
  <div class="post-wrap">
    <a href="/" class="back-link">Back to feed</a>

    <article class="post-article">
      <header>
        <h1>{post.title}</h1>
        <div class="post-meta">
          <span>By <strong>{authorName}</strong></span>
          <span class="dot"></span>
          <time datetime={post.created_at}>{dateStr}</time>
        </div>
      </header>

      {post.body && <p class="post-body">{post.body}</p>}

            {post.media_type === 'image' && post.media_url && (
        <figure class="post-media">
          <img src={post.media_url} alt={post.title} />
        </figure>
      )}

      <!-- Contact CTA -->
      <div class="contact-cta">
        <div class="contact-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
        </div>
        <div class="contact-text">
          <h3>Contact Qaraye Marchants to complete your purchases</h3>
          <p>Reach out directly to finalise this listing, negotiate terms, or arrange payment and delivery.</p>
        </div>
        <a href="https://wa.me/2348037411688?text=Hi%20Qaraye%20Marchants%2C%20I%20am%20interested%20in%20your%20listing%3A%20{encodeURIComponent(post.title)}" target="_blank" rel="noopener" class="btn btn-primary contact-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          Contact Now
        </a>
      </div>
    </article>

    <Comments postId={post.id} initialComments={comments} currentUserId={user?.id ?? null} />
  </div>
</Layout>

<style>
  .post-wrap { padding-top: 40px; padding-bottom: 80px; max-width: 780px; }
  .back-link {
    display: inline-block; font-family: var(--mono); font-size: 12px;
    color: var(--ink-faint); text-decoration: none; margin-bottom: 24px;
  }
  .back-link:hover { color: var(--cyan); }
  .post-article {
    background: var(--bg-900); border: 1px solid var(--line-soft);
    border-radius: var(--r-lg); padding: 32px;
  }
  .post-article h1 {
    font-family: var(--display); font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700; line-height: 1.25; margin: 0 0 12px; color: var(--ink);
  }
  .post-meta {
    display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap;
    font-family: var(--mono); font-size: 12px; color: var(--ink-faint);
    margin-bottom: 24px;
  }
  .post-meta strong { color: var(--cyan); font-weight: 600; }
  .dot { width: 3px; height: 3px; border-radius: 50%; background: var(--ink-faint); }
  .post-body {
    font-size: 1.05rem; line-height: 1.7; color: var(--ink-muted);
    white-space: pre-wrap; word-break: break-word; margin: 0 0 24px;
  }
  .post-media {
    margin: 0; border-radius: var(--r-md); overflow: hidden;
    background: var(--bg-950); border: 1px solid var(--line-soft);
  }
  .post-media img { display: block; width: 100%; height: auto; }
  @media (max-width: 560px) { .post-article { padding: 22px 18px; } }
  /* Contact CTA */
  .contact-cta {
    margin-top: 28px;
    padding: 24px;
    background: linear-gradient(135deg, rgba(0, 229, 255, 0.06) 0%, rgba(139, 92, 246, 0.06) 100%);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-lg);
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .contact-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--cyan), var(--violet));
    display: flex;
    align-items: center;
    justify-content: center;
    color: #05070f;
    flex-shrink: 0;
    box-shadow: 0 0 24px rgba(0, 229, 255, 0.35);
  }
  .contact-text {
    flex: 1 1 260px;
    min-width: 0;
  }
  .contact-text h3 {
    font-family: var(--display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 4px;
    line-height: 1.35;
  }
  .contact-text p {
    font-size: 0.88rem;
    color: var(--ink-muted);
    margin: 0;
    line-height: 1.5;
  }
  .contact-btn {
    flex-shrink: 0;
    padding: 12px 22px;
  }
  @media (max-width: 640px) {
    .contact-cta { padding: 20px 16px; }
    .contact-btn { width: 100%; justify-content: center; }
  }
</style>