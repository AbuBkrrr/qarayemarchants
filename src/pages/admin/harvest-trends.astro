---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

const { data: signals } = await supabase
  .from('qm_price_signals')
  .select('*')
  .order('recorded_at', { ascending: false })
  .limit(500);

const rows = signals || [];
---

<Layout title="Harvest Trends Admin - Qaraye Marchants">
  <div class="container" style="padding: 40px 24px;">

    <div id="loading" style="text-align:center; padding: 80px 20px;">
      <p style="color: var(--ink-muted); font-family: var(--mono); font-size: 13px;">Checking access…</p>
    </div>

    <div id="denied" style="display:none; text-align:center; padding: 80px 20px;">
      <h1 style="font-family: var(--display); font-size: 2rem;">Access denied</h1>
      <p style="color: var(--ink-muted);">This page is for administrators only.</p>
      <a href="/login" class="btn btn-primary" style="margin-top: 16px;">Sign in</a>
    </div>

    <div id="admin-content" style="display:none;">
      <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:24px; flex-wrap:wrap; gap:16px;">
        <div>
          <h1 style="font-family: var(--display); font-size: 1.8rem; margin: 0 0 6px 0;">Harvest Price Signals</h1>
          <p style="color: var(--ink-muted); margin: 0;">Manage the price data that powers the "Harvest Season Price Trends" chart.</p>
        </div>
        <button id="add-btn" class="btn btn-primary">+ Add Signal</button>
      </div>

      <!-- Filter tabs -->
      <div id="filter-tabs" style="display:flex; gap:6px; margin-bottom:16px; background: var(--bg-850); padding: 4px; border-radius: var(--r-full); width: fit-content;">
        <button class="filter-tab active" data-status="all">All</button>
        <button class="filter-tab" data-status="approved">Approved</button>
        <button class="filter-tab" data-status="suspended">Suspended</button>
      </div>

      <!-- Add / Edit form -->
      <div id="add-form" style="display:none; background: var(--card-bg); border: 1px solid var(--card-border); border-radius: var(--r-lg); padding: 20px; margin-bottom: 24px;">
        <h3 id="form-title" style="font-family: var(--display); margin: 0 0 14px 0;">New Price Signal</h3>
        <input type="hidden" id="f-edit-id" value="" />
        <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px;">
          <label style="font-family: var(--mono); font-size: 11px; color: var(--ink-muted);">CATEGORY<br>
            <select id="f-category" style="width:100%; padding:8px; margin-top:4px; background: var(--bg-850); border:1px solid var(--line-soft); border-radius: 6px; color: var(--ink);">
              <option value="grains">Grains & Cereals</option>
              <option value="tubers">Tubers & Roots</option>
              <option value="livestock">Livestock & Poultry</option>
              <option value="fruits">Fruits & Vegetables</option>
              <option value="seeds">Seeds & Seedlings</option>
              <option value="fertilizers">Fertilizers & Inputs</option>
            </select>
          </label>
          <label style="font-family: var(--mono); font-size: 11px; color: var(--ink-muted);">ITEM NAME<br>
            <input id="f-item" type="text" placeholder="e.g. Rice (local)" style="width:100%; padding:8px; margin-top:4px; background: var(--bg-850); border:1px solid var(--line-soft); border-radius: 6px; color: var(--ink);" />
          </label>
          <label style="font-family: var(--mono); font-size: 11px; color: var(--ink-muted);">PRICE (₦)<br>
            <input id="f-price" type="number" placeholder="1200" style="width:100%; padding:8px; margin-top:4px; background: var(--bg-850); border:1px solid var(--line-soft); border-radius: 6px; color: var(--ink);" />
          </label>
          <label style="font-family: var(--mono); font-size: 11px; color: var(--ink-muted);">UNIT<br>
            <select id="f-unit" style="width:100%; padding:8px; margin-top:4px; background: var(--bg-850); border:1px solid var(--line-soft); border-radius: 6px; color: var(--ink);">
              <option value="kg">kg</option>
              <option value="bag">bag</option>
              <option value="ton">ton</option>
              <option value="piece">piece</option>
              <option value="liter">liter</option>
            </select>
          </label>
          <label style="font-family: var(--mono); font-size: 11px; color: var(--ink-muted);">DATE<br>
            <input id="f-date" type="date" style="width:100%; padding:8px; margin-top:4px; background: var(--bg-850); border:1px solid var(--line-soft); border-radius: 6px; color: var(--ink);" />
          </label>
          <label style="font-family: var(--mono); font-size: 11px; color: var(--ink-muted);">SOURCE<br>
            <select id="f-source" style="width:100%; padding:8px; margin-top:4px; background: var(--bg-850); border:1px solid var(--line-soft); border-radius: 6px; color: var(--ink);">
              <option value="admin">Manual (admin)</option>
              <option value="news">News</option>
              <option value="listing">Listing</option>
            </select>
          </label>
        </div>
        <div style="margin-top: 14px; display: flex; gap: 10px;">
          <button id="save-btn" class="btn btn-primary">Save Signal</button>
          <button id="cancel-btn" class="btn btn-ghost">Cancel</button>
        </div>
      </div>

      <div style="background: var(--card-bg); border: 1px solid var(--card-border); border-radius: var(--r-lg); overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; font-family: var(--mono); font-size: 12.5px;">
          <thead>
            <tr style="background: var(--bg-850); text-align: left;">
              <th style="padding: 10px 14px;">Date</th>
              <th style="padding: 10px 14px;">Item</th>
              <th style="padding: 10px 14px;">Category</th>
              <th style="padding: 10px 14px; text-align: right;">Price</th>
              <th style="padding: 10px 14px;">Source</th>
              <th style="padding: 10px 14px;">Status</th>
              <th style="padding: 10px 14px; text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody id="signals-body"></tbody>
        </table>
        <p id="empty-msg" style="text-align:center; padding: 40px; color: var(--ink-muted); display:none;">No signals yet. Click "Add Signal" to create the first one.</p>
      </div>
    </div>

  </div>

  <script type="application/json" id="rows-data" set:html={JSON.stringify(rows)} />

  <script>
    import { supabase } from '../../lib/supabase';

    let rows: any[] = JSON.parse(document.getElementById('rows-data')?.textContent || '[]');
    let currentFilter: 'all' | 'approved' | 'suspended' = 'all';

    const loadingEl = document.getElementById('loading')!;
    const deniedEl = document.getElementById('denied')!;
    const contentEl = document.getElementById('admin-content')!;

    async function getToken(): Promise<string> {
      const { data: { session } } = await supabase.auth.getSession();
      return session?.access_token || '';
    }

    (async function checkAdmin() {
      try {
        const { data: { user } } = await supabase.auth.getUser();
        if (!user) { loadingEl.style.display = 'none'; deniedEl.style.display = 'block'; return; }
        const { data: prof } = await supabase.from('profiles').select('is_admin').eq('id', user.id).single();
        if (!prof?.is_admin) { loadingEl.style.display = 'none'; deniedEl.style.display = 'block'; return; }
        loadingEl.style.display = 'none';
        contentEl.style.display = 'block';
        initAdminUI();
      } catch (err) {
        console.error(err);
        loadingEl.style.display = 'none';
        deniedEl.style.display = 'block';
      }
    })();

    function renderTable() {
      const tbody = document.getElementById('signals-body')!;
      const emptyMsg = document.getElementById('empty-msg')!;

      const filtered = currentFilter === 'all'
        ? rows
        : rows.filter(r => r.status === currentFilter);

      if (filtered.length === 0) {
        emptyMsg.style.display = 'block';
        emptyMsg.textContent = currentFilter === 'all'
          ? 'No signals yet. Click "Add Signal" to create the first one.'
          : `No ${currentFilter} signals.`;
      } else {
        emptyMsg.style.display = 'none';
      }

      tbody.innerHTML = filtered.map((r: any) => {
        const isSuspended = r.status === 'suspended';
        const statusColor = isSuspended ? '#f59e0b' : '#10d982';
        const statusBg = isSuspended ? 'rgba(245,158,11,0.15)' : 'rgba(16,217,130,0.15)';
        return `
        <tr data-id="${r.id}" style="border-top: 1px solid var(--line-soft); ${isSuspended ? 'opacity:0.6;' : ''}">
          <td style="padding: 10px 14px; color: var(--ink-muted);">${r.recorded_at}</td>
          <td style="padding: 10px 14px; color: var(--ink);">${r.item_name}</td>
          <td style="padding: 10px 14px; color: var(--ink-muted);">${r.category}</td>
          <td style="padding: 10px 14px; text-align: right; color: var(--cyan); font-weight: 700;">₦${Number(r.price).toLocaleString()}/${r.unit}</td>
          <td style="padding: 10px 14px;"><span style="font-size: 10px; padding: 2px 8px; border-radius: 4px; background: var(--bg-850); color: var(--ink-muted);">${r.source}</span></td>
          <td style="padding: 10px 14px;"><span style="font-size: 10px; padding: 2px 8px; border-radius: 4px; background: ${statusBg}; color: ${statusColor};">${r.status}</span></td>
          <td style="padding: 10px 14px; text-align: right; white-space: nowrap;">
            <button data-toggle="${r.id}" title="${isSuspended ? 'Re-approve' : 'Suspend'}" style="background: transparent; border: 1px solid ${isSuspended ? 'rgba(16,217,130,0.3)' : 'rgba(245,158,11,0.3)'}; color: ${isSuspended ? '#10d982' : '#f59e0b'}; padding: 4px 10px; border-radius: 4px; cursor: pointer; font-size: 11px; margin-right: 6px;">
              ${isSuspended ? 'Approve' : 'Suspend'}
            </button>
            <button data-edit="${r.id}" title="Edit" style="background: transparent; border: 1px solid var(--line); color: var(--ink-muted); padding: 4px 10px; border-radius: 4px; cursor: pointer; font-size: 11px; margin-right: 6px;">Edit</button>
            <button data-del="${r.id}" title="Delete" style="background: transparent; border: 1px solid rgba(239,68,68,0.3); color: #ef4444; padding: 4px 10px; border-radius: 4px; cursor: pointer; font-size: 11px;">Delete</button>
          </td>
        </tr>
        `;
      }).join('');
    }

    function resetForm() {
      (document.getElementById('f-edit-id') as HTMLInputElement).value = '';
      (document.getElementById('f-item') as HTMLInputElement).value = '';
      (document.getElementById('f-price') as HTMLInputElement).value = '';
      (document.getElementById('f-category') as HTMLSelectElement).value = 'grains';
      (document.getElementById('f-unit') as HTMLSelectElement).value = 'kg';
      (document.getElementById('f-source') as HTMLSelectElement).value = 'admin';
      (document.getElementById('f-date') as HTMLInputElement).valueAsDate = new Date();
      document.getElementById('form-title')!.textContent = 'New Price Signal';
      (document.getElementById('save-btn') as HTMLButtonElement).textContent = 'Save Signal';
    }

    function initAdminUI() {
      renderTable();

      // Filter tabs
      document.querySelectorAll('.filter-tab').forEach((tab) => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          currentFilter = (tab as HTMLElement).dataset.status as any;
          renderTable();
        });
      });

      // Form toggle
      document.getElementById('add-btn')?.addEventListener('click', () => {
        const f = document.getElementById('add-form')!;
        if (f.style.display === 'block') {
          f.style.display = 'none';
        } else {
          resetForm();
          f.style.display = 'block';
        }
      });
      document.getElementById('cancel-btn')?.addEventListener('click', () => {
        document.getElementById('add-form')!.style.display = 'none';
        resetForm();
      });

      // Row actions (delegated)
      document.addEventListener('click', async (e) => {
        const t = e.target as HTMLElement;

        // Edit
        if ((t as any).dataset.edit) {
          const id = (t as any).dataset.edit;
          const r = rows.find(x => String(x.id) === String(id));
          if (!r) return;
          (document.getElementById('f-edit-id') as HTMLInputElement).value = r.id;
          (document.getElementById('f-item') as HTMLInputElement).value = r.item_name;
          (document.getElementById('f-price') as HTMLInputElement).value = r.price;
          (document.getElementById('f-category') as HTMLSelectElement).value = r.category;
          (document.getElementById('f-unit') as HTMLSelectElement).value = r.unit;
          (document.getElementById('f-source') as HTMLSelectElement).value = r.source;
          (document.getElementById('f-date') as HTMLInputElement).value = r.recorded_at;
          document.getElementById('form-title')!.textContent = `Edit Signal #${r.id}`;
          (document.getElementById('save-btn') as HTMLButtonElement).textContent = 'Update Signal';
          const f = document.getElementById('add-form')!;
          f.style.display = 'block';
          f.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }

        // Toggle status (Suspend / Approve)
        if ((t as any).dataset.toggle) {
          const id = (t as any).dataset.toggle;
          const r = rows.find(x => String(x.id) === String(id));
          if (!r) return;
          const next = r.status === 'suspended' ? 'approved' : 'suspended';
          const ok = confirm(`Are you sure you want to ${next === 'suspended' ? 'suspend' : 're-approve'} this signal?`);
          if (!ok) return;
          const token = await getToken();
          const res = await fetch('/api/price-signals/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
            body: JSON.stringify({ id, status: next }),
          });
          if (res.ok) {
            r.status = next;
            renderTable();
          } else {
            alert('Failed: ' + await res.text());
          }
          return;
        }

        // Delete
        if ((t as any).dataset.del) {
          if (!confirm('Delete this signal permanently?')) return;
          const token = await getToken();
          const res = await fetch('/api/price-signals/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
            body: JSON.stringify({ id: (t as any).dataset.del }),
          });
          if (res.ok) location.reload();
          else alert('Failed: ' + await res.text());
          return;
        }
      });

      // Save / Update
      document.getElementById('save-btn')?.addEventListener('click', async () => {
        const editId = (document.getElementById('f-edit-id') as HTMLInputElement).value.trim();
        const payload: any = {
          category: (document.getElementById('f-category') as HTMLSelectElement).value,
          item_name: (document.getElementById('f-item') as HTMLInputElement).value.trim(),
          price: Number((document.getElementById('f-price') as HTMLInputElement).value),
          unit: (document.getElementById('f-unit') as HTMLSelectElement).value,
          recorded_at: (document.getElementById('f-date') as HTMLInputElement).value,
          source: (document.getElementById('f-source') as HTMLSelectElement).value,
        };
        if (!payload.item_name || !payload.price || !payload.recorded_at) {
          alert('Please fill all fields');
          return;
        }

        const token = await getToken();
        const endpoint = editId ? '/api/price-signals/update' : '/api/price-signals/create';
        if (editId) payload.id = editId;

        const r = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify(payload),
        });
        if (r.ok) location.reload();
        else alert('Failed: ' + await r.text());
      });
    }
  </script>

  <style>
    .filter-tab {
      font-family: var(--body);
      font-size: 12.5px;
      font-weight: 600;
      padding: 6px 16px;
      border-radius: var(--r-full);
      border: none;
      cursor: pointer;
      background: transparent;
      color: var(--ink-muted);
      transition: 0.15s;
    }
    .filter-tab.active {
      background: var(--cyan);
      color: var(--bg-950);
    }
    .filter-tab:not(.active):hover {
      color: var(--ink);
    }
  </style>
</Layout>