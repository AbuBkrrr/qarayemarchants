---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us — Qaraye Marchants" description="Get in touch with the Qaraye Marchants team.">
  <div class="container" style="padding: 60px 24px; max-width: 700px;">
    <h1 style="font-family: var(--display); font-size: 2.2rem; margin-bottom: 8px; color: var(--ink);">Contact Us</h1>
    <p style="color: var(--ink-muted); margin-bottom: 40px;">Have questions, feedback, or need help with your listing? We are here to assist you.</p>

    <div style="background: var(--card-bg); border: 1px solid var(--card-border); border-radius: var(--r-lg); padding: 32px;">
      <h2 style="font-family: var(--display); font-size: 1.2rem; margin: 0 0 20px 0; color: var(--ink);">Reach out to us</h2>
      
      <div style="display: flex; flex-direction: column; gap: 20px;">
        <div>
          <div style="font-family: var(--mono); font-size: 11px; color: var(--ink-muted); margin-bottom: 4px;">EMAIL</div>
          <a href="mailto:support@qarayemarchants.com.ng" style="color: var(--cyan); font-family: var(--body); font-size: 15px;">support@qarayemarchants.com.ng</a>
        </div>
        <div>
          <div style="font-family: var(--mono); font-size: 11px; color: var(--ink-muted); margin-bottom: 4px;">WHATSAPP</div>
          <a href="https://wa.me/2348000000000" target="_blank" rel="noopener noreferrer" style="color: var(--cyan); font-family: var(--body); font-size: 15px;">Message us on WhatsApp</a>
        </div>
      </div>
    </div>
  </div>
</Layout>
