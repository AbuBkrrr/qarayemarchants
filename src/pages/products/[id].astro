---
import Layout from '../../layouts/Layout.astro';
import { products } from '../../data/products.js';

const { id } = Astro.params;
const product = products.find(p => p.id === id);

if (!product) {
  return Astro.redirect('/products');
}
---

<Layout title={`${product.name} — Qaraye Marchants`} description={product.description}>
  <div class="container" style="padding: 40px 24px;">
    <a href="/products" style="font-family: var(--mono); font-size: 12px; color: var(--ink-muted); text-decoration: none; display: inline-flex; align-items: center; gap: 6px; margin-bottom: 24px;">
      ← Back to Products
    </a>

    <div style="display: grid; gap: 40px; grid-template-columns: 1fr 1fr;">
      <div style="background: var(--bg-850); border-radius: var(--r-lg); overflow: hidden; height: 400px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--card-border);">
        {product.image ? <img src={product.image} alt={product.name} style="width: 100%; height: 100%; object-fit: cover;" /> : <span style="font-family: var(--mono); color: var(--ink-faint);">Product Image</span>}
      </div>

      <div>
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
          <h1 style="font-family: var(--display); font-size: 2rem; margin: 0; color: var(--ink);">{product.name}</h1>
          {product.verified && <span style="font-size: 12px; padding: 4px 12px; border-radius: var(--r-full); background: var(--cyan-soft); color: var(--cyan); font-family: var(--mono);">✅ Verified</span>}
        </div>

        <p style="font-size: 1.5rem; font-family: var(--display); font-weight: 700; color: var(--cyan); margin: 0 0 8px 0;">₦{product.price.toLocaleString()} <span style="font-size: 0.9rem; font-weight: 400; color: var(--ink-muted); font-family: var(--body);">{product.unit}</span></p>
        <p style="color: var(--ink-muted); margin-bottom: 24px;">{product.location} • {product.quantity} units available</p>

        <h2 style="font-family: var(--display); font-size: 1.2rem; color: var(--ink); margin-bottom: 8px;">Description</h2>
        <p style="color: var(--ink-muted); line-height: 1.8; margin-bottom: 32px;">{product.description}</p>

        <h2 style="font-family: var(--display); font-size: 1.2rem; color: var(--ink); margin-bottom: 8px;">Merchant</h2>
        <p style="color: var(--ink-muted); margin-bottom: 32px;">{product.merchantName}</p>

        <a href="/contact" class="btn btn-primary" style="width: 100%; padding: 16px; font-size: 1rem;">
          Contact Seller
        </a>
      </div>
    </div>
  </div>
</Layout>
