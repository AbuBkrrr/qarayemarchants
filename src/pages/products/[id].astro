---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

// ?? CONFIGURE YOUR WHATSAPP NUMBER HERE (country code + number, no +, no spaces)
const whatsappNumber = "2348037411688";

const { id } = Astro.params;

const { data: product, error } = await supabase
  .from('products')
  .select('*')
  .eq('id', id)
  .single();

if (error || !product) {
  return Astro.redirect('/products');
}

const message = `Hello Qaraye Marchants, I am interested in your listing: ${product.title} (ID: ${product.id}). Please provide more details.`;
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;

const mediaList = product.media_urls || product.image_urls || [];
const primaryMedia = mediaList.length > 0 ? mediaList[0] : null;
const isVideo = primaryMedia?.match(/\.(mp4|webm|mov)$/i);
---

<Layout title={`${product.title} — Qaraye Marchants`} description={product.description}>
  <div class="container" style="padding: 40px 24px;">
    <a href="/products" style="font-family: var(--mono); font-size: 12px; color: var(--ink-muted); text-decoration: none; display: inline-flex; align-items: center; gap: 6px; margin-bottom: 24px;">
      ? Back to Products
    </a>

    <div class="product-grid" style="display: grid; gap: 40px; grid-template-columns: 1fr 1fr;">
      <!-- Media Section -->
      <div>
        <div style="background: var(--bg-850); border-radius: var(--r-lg); overflow: hidden; height: 400px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--card-border);">
          {primaryMedia ? (
            isVideo ? (
              <video src={primaryMedia} controls style="width: 100%; height: 100%; object-fit: cover;"></video>
            ) : (
              <img src={primaryMedia} alt={product.title} style="width: 100%; height: 100%; object-fit: cover;" />
            )
          ) : (
            <span style="font-family: var(--mono); color: var(--ink-faint);">No Media Available</span>
          )}
        </div>

        <!-- Thumbnail Gallery -->
        {mediaList.length > 1 && (
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(80px, 1fr)); gap: 8px; margin-top: 12px;">
            {mediaList.map((url) => {
              const isVid = url.match(/\.(mp4|webm|mov)$/i);
              return (
                <div style="aspect-ratio: 1; border-radius: var(--r-sm); overflow: hidden; border: 1px solid var(--line-soft);">
                  {isVid ? (
                    <video src={url} style="width: 100%; height: 100%; object-fit: cover;" muted></video>
                  ) : (
                    <img src={url} alt="Thumbnail" style="width: 100%; height: 100%; object-fit: cover;" />
                  )}
                </div>
              );
            })}
          </div>
        )}
      </div>

      <!-- Details Section -->
      <div>
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px; flex-wrap: wrap;">
          <h1 style="font-family: var(--display); font-size: 2rem; margin: 0; color: var(--ink);">{product.title}</h1>
          <span style="font-size: 12px; padding: 4px 12px; border-radius: var(--r-full); background: var(--cyan-soft); color: var(--cyan); font-family: var(--mono);">? Verified</span>
        </div>

        <p style="font-size: 1.5rem; font-family: var(--display); font-weight: 700; color: var(--cyan); margin: 0 0 8px 0;">
          ?{Number(product.price).toLocaleString()} 
          <span style="font-size: 0.9rem; font-weight: 400; color: var(--ink-muted); font-family: var(--body);">per {product.unit}</span>
        </p>
        <p style="color: var(--ink-muted); margin-bottom: 24px;">?? {product.location_state || 'Nigeria'} • {product.quantity} units available</p>

        <h2 style="font-family: var(--display); font-size: 1.2rem; color: var(--ink); margin-bottom: 8px;">Description</h2>
        <p style="color: var(--ink-muted); line-height: 1.8; margin-bottom: 32px;">{product.description}</p>

        <h2 style="font-family: var(--display); font-size: 1.2rem; color: var(--ink); margin-bottom: 8px;">Merchant</h2>
        <p style="color: var(--ink-muted); margin-bottom: 32px;">Qaraye Marchants Verified Seller</p>

        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="width: 100%; padding: 16px; font-size: 1rem; display: flex; align-items: center; justify-content: center; gap: 10px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          Contact Seller on WhatsApp
        </a>
        <p style="text-align: center; font-family: var(--mono); font-size: 11px; color: var(--ink-faint); margin-top: 12px;">You will be redirected to WhatsApp to message the merchant.</p>
      </div>
    </div>
  </div>
</Layout>

<style>
  @media (max-width: 768px) {
    .product-grid {
      grid-template-columns: 1fr !important;
      gap: 24px !important;
    }
  }
</style>
