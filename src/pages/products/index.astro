---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

const { data: products, error } = await supabase
  .from('products')
  .select('*')
  .eq('status', 'active')
  .order('created_at', { ascending: false });
---

<Layout title="Marketplace — Qaraye Marchants" description="Browse agricultural products from merchants across Nigeria.">
  <div class="container" style="padding: 40px 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; flex-wrap: wrap; gap: 16px;">
      <div>
        <h1 style="font-family: var(--display); font-size: 2rem; margin: 0; color: var(--ink);">Marketplace</h1>
        <p style="color: var(--ink-muted); margin: 4px 0 0 0;">Browse fresh produce and agricultural goods from verified merchants.</p>
      </div>
      <a href="/dashboard/create-listing" class="btn btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        List Your Product
      </a>
    </div>

    {error && (
      <div style="background: var(--bg-850); padding: 16px; border-radius: var(--r-md); border: 1px solid var(--red); color: var(--red); margin-bottom: 24px;">
        Error loading products: {error.message}
      </div>
    )}

    {(!products || products.length === 0) ? (
      <div style="text-align: center; padding: 80px 20px; background: var(--bg-900); border: 1px dashed var(--line-strong); border-radius: var(--r-lg);">
        <h2 style="font-family: var(--display); color: var(--ink);">No products listed yet</h2>
        <p style="color: var(--ink-muted); margin-bottom: 24px;">Be the first merchant to list a product on the marketplace.</p>
        <a href="/dashboard/create-listing" class="btn btn-primary">Create a Listing</a>
      </div>
    ) : (
      <div style="display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        {products.map((product) => {
          const mediaList = product.media_urls || product.image_urls || [];
          const primaryMedia = mediaList.length > 0 ? mediaList[0] : null;
          const isVideo = primaryMedia?.match(/\.(mp4|webm|mov)$/i);
          
          return (
            <a href={`/products/${product.id}`} style="text-decoration: none; display: flex; flex-direction: column; background: var(--card-bg); border: 1px solid var(--card-border); border-radius: var(--r-lg); overflow: hidden; transition: transform 0.2s, box-shadow 0.2s;">
              <div style="height: 180px; background: var(--bg-800); display: flex; align-items: center; justify-content: center; border-bottom: 1px solid var(--line-soft); overflow: hidden;">
                {primaryMedia ? (
                  isVideo ? (
                    <video src={primaryMedia} style="width: 100%; height: 100%; object-fit: cover;" muted></video>
                  ) : (
                    <img src={primaryMedia} alt={product.title} style="width: 100%; height: 100%; object-fit: cover;" />
                  )
                ) : (
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--ink-faint)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                )}
              </div>
              <div style="padding: 16px; flex: 1; display: flex; flex-direction: column;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
                  <span style="font-family: var(--mono); font-size: 10px; text-transform: uppercase; color: var(--cyan); background: var(--cyan-soft); padding: 2px 8px; border-radius: var(--r-full);">{product.category}</span>
                  <span style="font-family: var(--mono); font-size: 11px; color: var(--ink-faint);">{product.unit}</span>
                </div>
                <h3 style="font-family: var(--display); font-size: 1.1rem; margin: 0 0 4px 0; color: var(--ink);">{product.title}</h3>
                <p style="color: var(--ink-muted); font-size: 0.85rem; margin: 0 0 16px 0; flex: 1; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{product.description}</p>
                <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--line-soft); padding-top: 12px;">
                  <div>
                    <div style="font-family: var(--display); font-weight: 700; font-size: 1.2rem; color: var(--cyan);">₦{Number(product.price).toLocaleString()}</div>
                    <div style="font-family: var(--mono); font-size: 10px; color: var(--ink-faint);">{product.location_state || 'Nigeria'}</div>
                  </div>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--ink-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    )}
  </div>
</Layout>
