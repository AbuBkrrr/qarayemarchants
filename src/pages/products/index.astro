---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

const url = Astro.url;
const params = url.searchParams;

const q = params.get('q')?.trim() || '';
const category = params.get('category') || '';
const state = params.get('state') || '';
const minPrice = params.get('min') ? Number(params.get('min')) : null;
const maxPrice = params.get('max') ? Number(params.get('max')) : null;
const sort = params.get('sort') || 'newest';

// Build query
let query = supabase
  .from('products')
  .select('id, title, description, category, price, unit, location_state, media_urls, image_urls, views, created_at, status')
  .eq('status', 'active');

if (q) query = query.or(`title.ilike.%${q}%,description.ilike.%${q}%`);
if (category) query = query.eq('category', category);
if (state) query = query.ilike('location_state', `%${state}%`);
if (minPrice !== null) query = query.gte('price', minPrice);
if (maxPrice !== null) query = query.lte('price', maxPrice);

switch (sort) {
  case 'price-asc': query = query.order('price', { ascending: true }); break;
  case 'price-desc': query = query.order('price', { ascending: false }); break;
  case 'popular': query = query.order('views', { ascending: false, nullsFirst: false }); break;
  default: query = query.order('created_at', { ascending: false });
}

const { data: products, error } = await query.limit(60);

// Fetch available categories and states for filter dropdowns
const { data: allProducts } = await supabase
  .from('products')
  .select('category, location_state')
  .eq('status', 'active');

const categoriesSet = new Set<string>();
const statesSet = new Set<string>();
(allProducts || []).forEach(p => {
  if (p.category) categoriesSet.add(p.category);
  if (p.location_state) statesSet.add(p.location_state);
});

const categoryLabels: Record<string, string> = {
  grains: 'Grains & Cereals',
  tubers: 'Tubers & Roots',
  livestock: 'Livestock & Poultry',
  fruits: 'Fruits & Vegetables',
  seeds: 'Seeds & Seedlings',
  fertilizers: 'Fertilizers & Inputs'
};

const categories = Array.from(categoriesSet);
const states = Array.from(statesSet).sort();

const hasFilters = !!(q || category || state || minPrice !== null || maxPrice !== null || sort !== 'newest');
const resultCount = products?.length || 0;
---

<Layout title="Marketplace - Qaraye Marchants" description="Browse agricultural products from merchants across Nigeria.">
  <div class="container" style="padding: 40px 24px;">

    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
      <div>
        <h1 style="font-family: var(--display); font-size: 2rem; margin: 0 0 6px 0; color: var(--ink);">Marketplace</h1>
        <p style="color: var(--ink-muted); margin: 0;">{resultCount} {resultCount === 1 ? 'product' : 'products'} found{hasFilters ? ' with current filters' : ''}.</p>
      </div>
      <a href="/dashboard/create-listing" class="btn btn-primary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        List Your Product
      </a>
    </div>

    <!-- Filter Form -->
    <form method="GET" action="/products" class="filter-form" id="filter-form">
      <div class="filter-grid">
        <!-- Search -->
        <div class="filter-field filter-search">
          <label>SEARCH</label>
          <input type="text" name="q" value={q} placeholder="Search products..." />
        </div>

        <!-- Category -->
        <div class="filter-field">
          <label>CATEGORY</label>
          <select name="category">
            <option value="">All Categories</option>
            {categories.map((cat) => (
              <option value={cat} selected={cat === category}>
                {categoryLabels[cat] || cat}
              </option>
            ))}
          </select>
        </div>

        <!-- State -->
        <div class="filter-field">
          <label>STATE</label>
          <select name="state">
            <option value="">All States</option>
            {states.map((s) => (
              <option value={s} selected={s === state}>{s}</option>
            ))}
          </select>
        </div>

        <!-- Min Price -->
        <div class="filter-field">
          <label>MIN PRICE (&#8358;)</label>
          <input type="number" name="min" value={minPrice !== null ? String(minPrice) : ''} placeholder="0" min="0" />
        </div>

        <!-- Max Price -->
        <div class="filter-field">
          <label>MAX PRICE (&#8358;)</label>
          <input type="number" name="max" value={maxPrice !== null ? String(maxPrice) : ''} placeholder="No limit" min="0" />
        </div>

        <!-- Sort -->
        <div class="filter-field">
          <label>SORT BY</label>
          <select name="sort">
            <option value="newest" selected={sort === 'newest'}>Newest First</option>
            <option value="popular" selected={sort === 'popular'}>Most Viewed</option>
            <option value="price-asc" selected={sort === 'price-asc'}>Price: Low to High</option>
            <option value="price-desc" selected={sort === 'price-desc'}>Price: High to Low</option>
          </select>
        </div>
      </div>

      <div class="filter-actions">
        <button type="submit" class="btn btn-primary" style="padding: 10px 22px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          Apply Filters
        </button>
        {hasFilters && (
          <a href="/products" class="btn btn-ghost" style="padding: 10px 22px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            Clear All
          </a>
        )}
      </div>
    </form>

    <!-- Active Filter Chips -->
    {hasFilters && (
      <div style="display: flex; gap: 8px; flex-wrap: wrap; margin: 20px 0;">
        {q && <span class="filter-chip">Search: "{q}"</span>}
        {category && <span class="filter-chip">{categoryLabels[category] || category}</span>}
        {state && <span class="filter-chip">State: {state}</span>}
        {minPrice !== null && <span class="filter-chip">Min: &#8358;{minPrice.toLocaleString()}</span>}
        {maxPrice !== null && <span class="filter-chip">Max: &#8358;{maxPrice.toLocaleString()}</span>}
        {sort !== 'newest' && <span class="filter-chip">Sort: {sort.replace('-', ' ')}</span>}
      </div>
    )}

    {error && (
      <div style="background: var(--bg-850); padding: 16px; border-radius: var(--r-md); border: 1px solid var(--red); color: var(--red); margin-bottom: 24px;">
        Error loading products: {error.message}
      </div>
    )}

    <!-- Products Grid -->
    {(!products || products.length === 0) ? (
      <div style="text-align: center; padding: 80px 20px; background: var(--bg-900); border: 1px dashed var(--line-strong); border-radius: var(--r-lg); margin-top: 24px;">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--ink-faint)" stroke-width="1.5" style="margin-bottom: 16px;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <h2 style="font-family: var(--display); color: var(--ink); margin: 0 0 8px 0;">
          {hasFilters ? 'No products match your filters' : 'No products listed yet'}
        </h2>
        <p style="color: var(--ink-muted); margin-bottom: 24px;">
          {hasFilters ? 'Try adjusting your search or clearing the filters.' : 'Be the first merchant to list a product on the marketplace.'}
        </p>
        {hasFilters ? (
          <a href="/products" class="btn btn-primary">Clear Filters</a>
        ) : (
          <a href="/dashboard/create-listing" class="btn btn-primary">Create a Listing</a>
        )}
      </div>
    ) : (
      <div style="display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); margin-top: 24px;">
        {products.map((product) => {
          const mediaList = product.media_urls || product.image_urls || [];
          const primaryMedia = mediaList.length > 0 ? mediaList[0] : null;
          const isVideo = primaryMedia?.match(/\.(mp4|webm|mov)$/i);
          return (
            <a href={`/products/${product.id}`} class="product-card">
              <div class="pc-thumb">
                {primaryMedia ? (
                  isVideo ? (
                    <video src={primaryMedia} muted style="width:100%;height:100%;object-fit:cover;"></video>
                  ) : (
                    <img src={primaryMedia} alt={product.title} loading="lazy" />
                  )
                ) : (
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--ink-faint)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                )}
              </div>
              <div class="pc-body">
                <div class="pc-toprow">
                  <span class="pc-cat">{categoryLabels[product.category] || product.category || 'General'}</span>
                  <span class="pc-unit">{product.unit}</span>
                </div>
                <h3 class="pc-title">{product.title}</h3>
                <p class="pc-desc">{product.description}</p>
                <div class="pc-bottom">
                  <div>
                    <div class="pc-price">&#8358;{Number(product.price).toLocaleString()}</div>
                    <div class="pc-loc">{product.location_state || 'Nigeria'} &bull; {product.views || 0} views</div>
                  </div>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--ink-muted)" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    )}
  </div>
</Layout>

<style is:global>
  .filter-form {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--r-lg);
    padding: 20px;
  }
  .filter-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 1fr 1fr;
    gap: 12px;
    margin-bottom: 14px;
  }
  .filter-field label {
    display: block;
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--ink-muted);
    margin-bottom: 6px;
  }
  .filter-field input,
  .filter-field select {
    width: 100%;
    padding: 10px 12px;
    background: var(--bg-850);
    border: 1px solid var(--line-soft);
    border-radius: var(--r-sm);
    color: var(--ink);
    font-family: var(--body);
    font-size: 13.5px;
  }
  .filter-field input:focus,
  .filter-field select:focus {
    outline: none;
    border-color: var(--cyan);
  }
  .filter-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .filter-chip {
    display: inline-flex;
    align-items: center;
    background: var(--cyan-soft);
    color: var(--cyan);
    font-family: var(--mono);
    font-size: 11px;
    padding: 4px 12px;
    border-radius: var(--r-full);
    border: 1px solid var(--line);
  }

  .product-card {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--r-lg);
    overflow: hidden;
    transition: transform 0.15s, border-color 0.15s, box-shadow 0.15s;
  }
  .product-card:hover {
    transform: translateY(-2px);
    border-color: var(--cyan);
    box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    opacity: 1;
  }
  .pc-thumb {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: var(--bg-800);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-bottom: 1px solid var(--line-soft);
  }
  .pc-thumb img,
  .pc-thumb video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pc-body {
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }
  .pc-toprow {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }
  .pc-cat {
    font-family: var(--mono);
    font-size: 10px;
    text-transform: uppercase;
    color: var(--cyan);
    background: var(--cyan-soft);
    padding: 2px 8px;
    border-radius: var(--r-full);
    letter-spacing: 0.04em;
  }
  .pc-unit {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--ink-faint);
  }
  .pc-title {
    font-family: var(--display);
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    color: var(--ink);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pc-desc {
    font-size: 0.83rem;
    color: var(--ink-muted);
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.5;
  }
  .pc-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    padding-top: 10px;
    border-top: 1px solid var(--line-soft);
  }
  .pc-price {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--cyan);
  }
  .pc-loc {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--ink-faint);
    margin-top: 2px;
  }

  @media (max-width: 1100px) {
    .filter-grid { grid-template-columns: 1fr 1fr 1fr; }
    .filter-search { grid-column: span 3; }
  }
  @media (max-width: 640px) {
    .filter-grid { grid-template-columns: 1fr 1fr; }
    .filter-search { grid-column: span 2; }
  }
</style>