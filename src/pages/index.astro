---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { supabase } from '../lib/supabase';

const nowISO = new Date().toISOString();

// Fetch latest community posts
// Note: status/published_at may be NULL for rows inserted without those fields
const { data: communityPosts } = await supabase
  .from('qm_posts')
  .select('id,title,body,media_thumbnail_url,media_type,created_at,published_at,user_id')
  .or('status.eq.published,status.is.null')
  .or(`published_at.lte.${nowISO},published_at.is.null`)
  .order('created_at', { ascending: false })
  .limit(9);

// Fetch author display names in one query
const userIds = [...new Set((communityPosts ?? []).map((p) => p.user_id))];
const profileMap: Record<string, string> = {};
if (userIds.length > 0) {
  const { data: profiles } = await supabase
    .from('profiles')
    .select('id,display_name')
    .in('id', userIds);
  if (profiles) for (const p of profiles) profileMap[p.id] = p.display_name;
}

// Fetch latest news
const { data: newsPosts } = await supabase
  .from('qm_news')
  .select('id,slug,title,description,source_name,published_at')
  .order('published_at', { ascending: false })
  .limit(9);

// Get comment counts for all fetched content in bulk
const postIds = (communityPosts ?? []).map((p) => p.id);
const newsIds = (newsPosts ?? []).map((n) => n.id);

const commentCounts: Record<string, number> = {};
if (postIds.length > 0) {
  const { data: counts } = await supabase
    .from('qm_comments')
    .select('post_id')
    .in('post_id', postIds);
  if (counts) for (const c of counts) commentCounts[c.post_id] = (commentCounts[c.post_id] ?? 0) + 1;
}
if (newsIds.length > 0) {
  const { data: counts } = await supabase
    .from('qm_news_comments')
    .select('news_id')
    .in('news_id', newsIds);
  if (counts) for (const c of counts) commentCounts[c.news_id] = (commentCounts[c.news_id] ?? 0) + 1;
}

// Merge + sort for unified feed
type FeedItem = {
  type: 'community' | 'news';
  id: string;
  title: string;
  description: string;
  thumbnailUrl: string | null;
  mediaType: 'image' | 'audio' | 'video' | 'none';
  authorName?: string;
  sourceName?: string;
  publishedAt: string;
  commentCount: number;
  href: string;
};

const feed: FeedItem[] = [];

(communityPosts ?? []).forEach((p) => {
  feed.push({
    type: 'community',
    id: p.id,
    title: p.title,
    description: p.body ?? '',
    thumbnailUrl: p.media_thumbnail_url ?? null,
    mediaType: (p.media_type ?? 'none') as any,
    authorName: profileMap[p.user_id] ?? 'Anonymous',
    publishedAt: p.published_at ?? p.created_at,
    commentCount: commentCounts[p.id] ?? 0,
    href: `/post/${p.id}`,
  });
});

(newsPosts ?? []).forEach((n) => {
  feed.push({
    type: 'news',
    id: n.id,
    title: n.title,
    description: n.description ?? '',
    thumbnailUrl: null,
    mediaType: 'none',
    sourceName: n.source_name ?? 'News',
    publishedAt: n.published_at,
    commentCount: commentCounts[n.id] ?? 0,
    href: `/news/${n.slug}`,
  });
});

feed.sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime());

const hasContent = feed.length > 0;
---

<Layout>
  <div class="container">

    <section class="hero">
      <div class="hero-badge">
        <span class="live-dot"></span>
        <span data-i18n="trending">Trending</span>
      </div>
      <h1>
        <span data-i18n="appName">Qaraye Marchants</span>
        <span class="hero-accent">.</span>
      </h1>
      <p class="hero-tagline" data-i18n="tagline">The pulse of Nigerian finance</p>
      <p class="hero-sub" data-i18n="subtitle">Read today's financial news, share your own insights, and discuss what matters with the community.</p>
    </section>

    <nav class="feed-tabs" aria-label="Feed filters">
      <button class="tab active" data-tab="all"><span data-i18n="tabAll">All</span></button>
      <button class="tab" data-tab="community"><span data-i18n="tabCommunity">Community</span></button>
      <button class="tab" data-tab="news"><span data-i18n="tabNews">News</span></button>
    </nav>

    {hasContent ? (
      <section class="feed" id="feed">
        {feed.map((item) => (
          <div class:list={['feed-item', 'feed-' + item.type]} data-feed-type={item.type}>
            <PostCard
              type={item.type}
              id={item.id}
              title={item.title}
              description={item.description}
              thumbnailUrl={item.thumbnailUrl}
              mediaType={item.mediaType}
              authorName={item.authorName}
              sourceName={item.sourceName}
              publishedAt={item.publishedAt}
              commentCount={item.commentCount}
              href={item.href}
            />
          </div>
        ))}
      </section>
    ) : (
      <section class="empty">
        <div class="empty-icon">
          <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:var(--ink-faint)">
            <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/>
          </svg>
        </div>
        <h2 data-i18n="noPosts">No posts yet. Be the first to share.</h2>
        <a href="/create" class="btn btn-primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          <span data-i18n="createPost">Create Post</span>
        </a>
      </section>
    )}

    <section class="newsletter">
      <div class="newsletter-inner">
        <div>
          <h3 data-i18n="subscribeTitle">Get daily Nigerian finance insights</h3>
          <p data-i18n="subscribeSubtitle">Short, practical, no spam. Unsubscribe anytime.</p>
        </div>
        <form class="newsletter-form" id="qm-lead-form">
          <input type="text" id="qm-lead-input" data-i18n-placeholder="subscribePlaceholder" placeholder="you@example.com or phone" />
          <button type="submit" class="btn btn-primary" data-i18n="subscribeButton">Subscribe</button>
        </form>
      </div>
      <p class="newsletter-status" id="qm-lead-status" hidden></p>
    </section>

  </div>
</Layout>

<style>
  .hero { padding: 60px 0 40px; text-align: center; }
  .hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--mono); font-size: 11px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--cyan); background: var(--cyan-soft);
    border: 1px solid var(--line); padding: 6px 14px;
    border-radius: var(--r-full); margin-bottom: 20px;
  }
  .live-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--cyan); box-shadow: 0 0 8px var(--cyan);
    animation: pulse 2s infinite;
  }
  @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }
  .hero h1 {
    font-family: var(--display); font-weight: 800;
    font-size: clamp(34px, 6vw, 60px); letter-spacing: -0.03em;
    line-height: 1.05; margin: 0 0 12px;
    background: linear-gradient(180deg, #ffffff 0%, #a5b0d5 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero-accent {
    background: linear-gradient(135deg, var(--cyan), var(--violet));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero-tagline {
    font-family: var(--mono); font-size: 13px; color: var(--cyan);
    text-transform: uppercase; letter-spacing: 0.1em; margin: 0 0 16px;
  }
  .hero-sub { color: var(--ink-muted); font-size: 16px; max-width: 620px; margin: 0 auto; line-height: 1.6; }

  .feed-tabs {
    display: flex; justify-content: center; gap: 6px;
    margin: 40px auto 32px; background: var(--bg-900);
    border: 1px solid var(--line-soft); border-radius: var(--r-full);
    padding: 6px; width: fit-content;
  }
  .tab {
    background: transparent; border: none;
    font-family: var(--body); font-size: 13px; font-weight: 600;
    color: var(--ink-muted); padding: 9px 22px;
    border-radius: var(--r-full); cursor: pointer; transition: 0.15s;
  }
  .tab:hover { color: var(--ink); }
  .tab.active {
    background: linear-gradient(135deg, var(--cyan), var(--violet));
    color: #05070f; box-shadow: 0 0 20px rgba(0, 229, 255, 0.3);
  }

  .feed {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 20px; margin-bottom: 80px;
  }
  .feed-item { display: contents; }

  .empty {
    text-align: center; padding: 60px 20px;
    background: var(--bg-900); border: 1px dashed var(--line);
    border-radius: var(--r-xl); margin-bottom: 60px;
  }
  .empty-icon { display: flex; justify-content: center; margin-bottom: 16px; }
  .empty h2 {
    font-family: var(--display); font-size: 1.4rem; color: var(--ink);
    margin: 0 0 20px; font-weight: 600;
  }

  .newsletter {
    background: linear-gradient(135deg, var(--bg-900) 0%, var(--bg-850) 100%);
    border: 1px solid var(--line); border-radius: var(--r-xl);
    padding: 32px; margin-bottom: 40px;
    position: relative; overflow: hidden;
  }
  .newsletter::before {
    content: ""; position: absolute; top: -50%; right: -10%;
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(0, 229, 255, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }
  .newsletter-inner {
    position: relative; display: flex; justify-content: space-between;
    align-items: center; gap: 24px; flex-wrap: wrap;
  }
  .newsletter h3 {
    font-family: var(--display); font-size: 1.3rem; font-weight: 700;
    color: var(--ink); margin: 0 0 6px;
  }
  .newsletter p { color: var(--ink-muted); font-size: 0.9rem; margin: 0; }
  .newsletter-form { display: flex; gap: 10px; flex: 1 1 360px; max-width: 480px; }
  .newsletter-form input {
    flex: 1; background: var(--bg-800); border: 1px solid var(--line-soft);
    border-radius: var(--r-full); padding: 12px 20px;
    color: var(--ink); font-family: var(--body); font-size: 14px;
  }
  .newsletter-form input:focus {
    outline: none; border-color: var(--cyan);
    box-shadow: 0 0 0 3px rgba(0, 229, 255, 0.1);
  }
  .newsletter-status { position: relative; margin: 12px 0 0; font-size: 0.88rem; text-align: center; }

  @media (max-width: 1000px) { .feed { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) {
    .feed { grid-template-columns: 1fr; }
    .hero { padding: 40px 0 24px; }
    .newsletter { padding: 22px 18px; }
  }
</style>

<script>
  import { supabase } from '../lib/supabase';

  // Tab filtering
  document.querySelectorAll('.tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      const which = tab.getAttribute('data-tab');
      document.querySelectorAll('.tab').forEach((t) => t.classList.toggle('active', t === tab));
      document.querySelectorAll('.feed-item').forEach((item) => {
        const type = item.getAttribute('data-feed-type');
        if (which === 'all') item.classList.remove('hidden');
        else if (which === type) item.classList.remove('hidden');
        else item.classList.add('hidden');
      });
    });
  });

  // Lead capture
  const form = document.getElementById('qm-lead-form') as HTMLFormElement | null;
  const input = document.getElementById('qm-lead-input') as HTMLInputElement | null;
  const status = document.getElementById('qm-lead-status') as HTMLParagraphElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!input || !status) return;
    const raw = input.value.trim();
    if (!raw) return;

    const isEmail = /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(raw);
    const isPhone = /^[+0-9()\-\s]{7,20}$/.test(raw);
    if (!isEmail && !isPhone) {
      status.textContent = 'Enter a valid email or phone number.';
      status.style.color = 'var(--red)';
      status.hidden = false;
      return;
    }

    const payload: { email?: string; phone?: string; source: string } = { source: 'homepage' };
    if (isEmail) payload.email = raw;
    else payload.phone = raw;

    const { error } = await supabase.from('qm_leads').insert(payload);
    if (error) {
      status.textContent = 'Could not save. Try again.';
      status.style.color = 'var(--red)';
      status.hidden = false;
      return;
    }

    status.textContent = 'Thanks! You are on the list.';
    status.style.color = 'var(--green)';
    status.hidden = false;
    input.value = '';
  });
</script>

<style>
  .feed-item.hidden { display: none !important; }
</style>