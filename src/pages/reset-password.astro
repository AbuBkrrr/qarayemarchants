---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Set New Password - Qaraye Marchants">
  <div class="container" style="padding: 60px 24px; max-width: 460px;">

    <h1 style="font-family: var(--display); font-size: 2rem; margin: 0 0 8px 0; color: var(--ink);">Set New Password</h1>
    <p style="color: var(--ink-muted); margin-bottom: 32px;">Choose a strong password. You'll be signed in automatically after saving.</p>

    <div id="invalid-link" style="display: none; padding: 20px; background: var(--bg-850); border: 1px solid var(--red); border-radius: var(--r-md); margin-bottom: 20px;">
      <p style="margin: 0 0 12px 0; color: var(--red); font-family: var(--mono); font-size: 12.5px;">
        <strong>Reset link is invalid or expired.</strong><br>
        This usually happens if the link was already used or was auto-scanned by your email provider.
      </p>
      <a href="/forgot-password" class="btn btn-primary" style="padding: 10px 20px;">Request a New Link</a>
    </div>

    <form id="reset-form" style="display: none; flex-direction: column; gap: 16px;">
      <div>
        <label for="new-password" style="display: block; font-family: var(--mono); font-size: 12px; margin-bottom: 6px; color: var(--ink-muted);">NEW PASSWORD</label>
        <input type="password" id="new-password" required minlength="6" autocomplete="new-password"
               style="width: 100%; padding: 12px; background: var(--bg-850); border: 1px solid var(--line-soft); border-radius: var(--r-sm); color: var(--ink); font-family: var(--body);">
      </div>

      <div>
        <label for="confirm-password" style="display: block; font-family: var(--mono); font-size: 12px; margin-bottom: 6px; color: var(--ink-muted);">CONFIRM PASSWORD</label>
        <input type="password" id="confirm-password" required minlength="6" autocomplete="new-password"
               style="width: 100%; padding: 12px; background: var(--bg-850); border: 1px solid var(--line-soft); border-radius: var(--r-sm); color: var(--ink); font-family: var(--body);">
      </div>

      <button type="submit" class="btn btn-primary" style="padding: 14px;">Save New Password</button>
    </form>

    <p id="checking" style="font-family: var(--mono); font-size: 12px; color: var(--ink-muted); text-align: center;">Verifying reset link...</p>
    <p id="status" style="margin-top: 16px; font-family: var(--mono); font-size: 13px; text-align: center;"></p>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('reset-form') as HTMLFormElement;
  const statusEl = document.getElementById('status')!;
  const checkingEl = document.getElementById('checking')!;
  const invalidLinkEl = document.getElementById('invalid-link')!;
  const newPwd = document.getElementById('new-password') as HTMLInputElement;
  const confirmPwd = document.getElementById('confirm-password') as HTMLInputElement;

  function showForm() {
    checkingEl.style.display = 'none';
    invalidLinkEl.style.display = 'none';
    form.style.display = 'flex';
  }

  function showInvalid() {
    checkingEl.style.display = 'none';
    form.style.display = 'none';
    invalidLinkEl.style.display = 'block';
  }

  // Check URL for error params
  const urlParams = new URLSearchParams(window.location.search);
  const errorCode = urlParams.get('error_code');
  const errorDesc = urlParams.get('error_description');

  if (errorCode || errorDesc) {
    showInvalid();
  } else {
    // Try to detect session from URL hash (Supabase handles this automatically)
    // Method 1: listen for PASSWORD_RECOVERY event
    supabase.auth.onAuthStateChange((event) => {
      if (event === 'PASSWORD_RECOVERY') {
        showForm();
      }
    });

    // Method 2: check if a session already exists (in case event fired before we subscribed)
    (async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (session) {
        showForm();
      } else {
        // Wait 2 seconds — if no session appears, it's an invalid link
        setTimeout(() => {
          if (form.style.display !== 'flex') {
            showInvalid();
          }
        }, 2000);
      }
    })();
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (newPwd.value !== confirmPwd.value) {
      statusEl.textContent = 'Passwords do not match.';
      statusEl.style.color = 'var(--red)';
      return;
    }

    if (newPwd.value.length < 6) {
      statusEl.textContent = 'Password must be at least 6 characters.';
      statusEl.style.color = 'var(--red)';
      return;
    }

    statusEl.textContent = 'Saving new password...';
    statusEl.style.color = 'var(--ink-muted)';

    const { error } = await supabase.auth.updateUser({ password: newPwd.value });

    if (error) {
      statusEl.textContent = 'Error: ' + error.message;
      statusEl.style.color = 'var(--red)';
      return;
    }

    statusEl.textContent = 'Password updated! Redirecting...';
    statusEl.style.color = 'var(--green)';
    setTimeout(() => window.location.href = '/', 1200);
  });
</script>