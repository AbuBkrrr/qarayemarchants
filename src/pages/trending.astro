---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

// Most-viewed active products
const { data: trendingProducts, error: productsError } = await supabase
  .from('products')
  .select('id, title, price, unit, category, location_state, media_urls, image_urls, views, created_at')
  .eq('status', 'active')
  .order('views', { ascending: false, nullsFirst: false })
  .order('created_at', { ascending: false })
  .limit(24);

const products = trendingProducts || [];
---

<Layout title="Trending - Qaraye Marchants" description="Most viewed products and trending items on Qaraye Marchants.">
  <div class="container" style="padding: 40px 24px;">

    <div style="margin-bottom: 40px;">
      <h1 style="font-family: var(--display); font-size: 2.2rem; margin: 0 0 8px 0; color: var(--ink);">Trending</h1>
      <p style="color: var(--ink-muted); margin: 0;">What buyers are viewing right now on Qaraye Marchants.</p>
    </div>

    <!-- TRENDING PRODUCTS -->
    <section style="margin-bottom: 48px;">
      <h2 style="font-family: var(--display); font-size: 1.4rem; margin: 0 0 20px 0; color: var(--ink); display: flex; align-items: center; gap: 10px;">
        <span style="color: var(--cyan); font-family: var(--mono);">#1</span> Most Viewed Products
      </h2>

      {products.length === 0 ? (
        <div style="text-align: center; padding: 60px 20px; background: var(--bg-900); border: 1px dashed var(--line-strong); border-radius: var(--r-lg);">
          <p style="color: var(--ink-muted); margin: 0 0 16px 0;">No products to rank yet. Start listing to see activity here.</p>
          <a href="/dashboard/create-listing" class="btn btn-primary">Create a Listing</a>
        </div>
      ) : (
        <div style="display: flex; flex-direction: column; gap: 10px;">
          {products.map((product, index) => {
            const mediaList = product.media_urls || product.image_urls || [];
            const primary = mediaList[0];
            const isVideo = primary && primary.match(/\.(mp4|webm|mov)$/i);
            const rank = index + 1;
            return (
              <a href={`/products/${product.id}`}
                 style="display: flex; align-items: center; gap: 16px; padding: 14px 16px; background: var(--card-bg); border: 1px solid var(--card-border); border-radius: var(--r-md); text-decoration: none; transition: 0.15s;"
                 onmouseover="this.style.borderColor='var(--cyan)';" onmouseout="this.style.borderColor='var(--card-border)';">
                <div style={`width: 36px; text-align: center; font-family: var(--display); font-weight: 800; font-size: 1.3rem; flex-shrink: 0; color: ${rank <= 3 ? 'var(--cyan)' : 'var(--ink-faint)'};`}>
                  {rank}
                </div>
                <div style="width: 56px; height: 56px; border-radius: var(--r-sm); overflow: hidden; background: var(--bg-800); flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
                  {primary ? (
                    isVideo ? (
                      <video src={primary} style="width: 100%; height: 100%; object-fit: cover;" muted></video>
                    ) : (
                      <img src={primary} alt={product.title} style="width: 100%; height: 100%; object-fit: cover;" />
                    )
                  ) : (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--ink-faint)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/></svg>
                  )}
                </div>
                <div style="flex: 1; min-width: 0;">
                  <div style="font-family: var(--display); font-weight: 600; font-size: 0.98rem; color: var(--ink); margin-bottom: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{product.title}</div>
                  <div style="font-family: var(--mono); font-size: 11px; color: var(--ink-muted);">{product.category || 'General'} &bull; {product.location_state || 'Nigeria'}</div>
                </div>
                <div style="text-align: right; flex-shrink: 0;">
                  <div style="font-family: var(--display); font-weight: 700; color: var(--cyan); font-size: 0.95rem;">&#8358;{Number(product.price).toLocaleString()}</div>
                  <div style="font-family: var(--mono); font-size: 10.5px; color: var(--ink-faint);">{product.views || 0} views</div>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </section>

    <!-- TRENDING NEWS placeholder -->
    <section>
      <h2 style="font-family: var(--display); font-size: 1.4rem; margin: 0 0 20px 0; color: var(--ink); display: flex; align-items: center; gap: 10px;">
        <span style="color: var(--cyan); font-family: var(--mono);">#2</span> Trending News
      </h2>
      <div style="text-align: center; padding: 40px 20px; background: var(--bg-900); border: 1px dashed var(--line-strong); border-radius: var(--r-lg);">
        <p style="color: var(--ink-muted); margin: 0; font-size: 0.9rem;">Trending news ranking will appear here once we connect the news source. Awaiting diagnostic results to wire it up.</p>
      </div>
    </section>

  </div>
</Layout>