---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="My Listings - Qaraye Marchants">
  <div class="container" style="padding: 40px 24px; max-width: 1100px;">

    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 32px; flex-wrap: wrap; gap: 16px;">
      <div>
        <h1 style="font-family: var(--display); font-size: 2rem; margin: 0 0 6px 0; color: var(--ink);">My Listings</h1>
        <p style="color: var(--ink-muted); margin: 0;">Manage your product listings, track views, and update details.</p>
      </div>
      <a href="/dashboard/create-listing" class="btn btn-primary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        New Listing
      </a>
    </div>

    <!-- Stats Grid -->
    <div id="stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 32px;">
      <div style="background: var(--card-bg); border: 1px solid var(--card-border); border-radius: var(--r-lg); padding: 20px;">
        <div style="font-family: var(--mono); font-size: 11px; color: var(--ink-muted); margin-bottom: 8px;">TOTAL LISTINGS</div>
        <div id="stat-total" style="font-family: var(--display); font-size: 2rem; font-weight: 700; color: var(--ink);">-</div>
      </div>
      <div style="background: var(--card-bg); border: 1px solid var(--card-border); border-radius: var(--r-lg); padding: 20px;">
        <div style="font-family: var(--mono); font-size: 11px; color: var(--ink-muted); margin-bottom: 8px;">ACTIVE</div>
        <div id="stat-active" style="font-family: var(--display); font-size: 2rem; font-weight: 700; color: var(--green);">-</div>
      </div>
      <div style="background: var(--card-bg); border: 1px solid var(--card-border); border-radius: var(--r-lg); padding: 20px;">
        <div style="font-family: var(--mono); font-size: 11px; color: var(--ink-muted); margin-bottom: 8px;">TOTAL VIEWS</div>
        <div id="stat-views" style="font-family: var(--display); font-size: 2rem; font-weight: 700; color: var(--cyan);">-</div>
      </div>
      <div style="background: var(--card-bg); border: 1px solid var(--card-border); border-radius: var(--r-lg); padding: 20px;">
        <div style="font-family: var(--mono); font-size: 11px; color: var(--ink-muted); margin-bottom: 8px;">SOLD</div>
        <div id="stat-sold" style="font-family: var(--display); font-size: 2rem; font-weight: 700; color: var(--amber);">-</div>
      </div>
    </div>

    <!-- Filter Tabs -->
    <div id="filter-tabs" style="display: flex; gap: 4px; background: var(--bg-850); padding: 4px; border-radius: var(--r-full); margin-bottom: 24px; width: fit-content;">
      <button class="filter-tab active" data-filter="all" style="font-family: var(--body); font-size: 13px; font-weight: 600; padding: 8px 18px; border-radius: var(--r-full); border: none; cursor: pointer; background: var(--cyan); color: var(--bg-950);">All</button>
      <button class="filter-tab" data-filter="active" style="font-family: var(--body); font-size: 13px; font-weight: 600; padding: 8px 18px; border-radius: var(--r-full); border: none; cursor: pointer; background: transparent; color: var(--ink-muted);">Active</button>
      <button class="filter-tab" data-filter="sold" style="font-family: var(--body); font-size: 13px; font-weight: 600; padding: 8px 18px; border-radius: var(--r-full); border: none; cursor: pointer; background: transparent; color: var(--ink-muted);">Sold</button>
      <button class="filter-tab" data-filter="archived" style="font-family: var(--body); font-size: 13px; font-weight: 600; padding: 8px 18px; border-radius: var(--r-full); border: none; cursor: pointer; background: transparent; color: var(--ink-muted);">Archived</button>
    </div>

    <!-- Listings List -->
    <div id="listings-container">
      <p id="loading" style="text-align: center; padding: 40px; color: var(--ink-muted); font-family: var(--mono); font-size: 12px;">Loading listings...</p>
    </div>

  </div>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  const container = document.getElementById('listings-container')!;
  const loading = document.getElementById('loading')!;
  const filterTabs = document.querySelectorAll('.filter-tab');

  let allListings: any[] = [];
  let currentFilter = 'all';

  function escapeHtml(s: string) {
    return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  }

  function renderStats() {
    const total = allListings.length;
    const active = allListings.filter(l => l.status === 'active').length;
    const sold = allListings.filter(l => l.status === 'sold').length;
    const views = allListings.reduce((sum, l) => sum + (l.views || 0), 0);
    document.getElementById('stat-total')!.textContent = String(total);
    document.getElementById('stat-active')!.textContent = String(active);
    document.getElementById('stat-sold')!.textContent = String(sold);
    document.getElementById('stat-views')!.textContent = String(views);
  }

  function statusBadge(status: string) {
    const colors: Record<string, string> = {
      active: 'background: rgba(16, 217, 130, 0.15); color: var(--green);',
      sold: 'background: rgba(245, 158, 11, 0.15); color: var(--amber);',
      archived: 'background: rgba(139, 149, 184, 0.15); color: var(--ink-muted);'
    };
    return '<span style="font-family: var(--mono); font-size: 10px; text-transform: uppercase; padding: 3px 10px; border-radius: var(--r-full); ' + (colors[status] || colors.archived) + '">' + status + '</span>';
  }

  function render() {
    const filtered = currentFilter === 'all'
      ? allListings
      : allListings.filter(l => l.status === currentFilter);

    if (filtered.length === 0) {
      container.innerHTML = '<div style="text-align: center; padding: 60px 20px; background: var(--bg-900); border: 1px dashed var(--line-strong); border-radius: var(--r-lg);"><p style="color: var(--ink-muted); margin: 0 0 16px 0;">No ' + (currentFilter === 'all' ? '' : currentFilter + ' ') + 'listings yet.</p><a href="/dashboard/create-listing" class="btn btn-primary">Create your first listing</a></div>';
      return;
    }

    const html = filtered.map(item => {
      const media = (item.media_urls && item.media_urls[0]) || (item.image_urls && item.image_urls[0]) || null;
      const isVideo = media && media.match(/\.(mp4|webm|mov)$/i);
      const mediaHtml = media
        ? (isVideo
            ? '<video src="' + media + '" muted style="width:100%;height:100%;object-fit:cover;"></video>'
            : '<img src="' + media + '" style="width:100%;height:100%;object-fit:cover;" />')
        : '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--ink-faint)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>';

      return '<div class="listing-row" data-id="' + item.id + '" data-status="' + item.status + '" style="display: flex; align-items: center; gap: 16px; padding: 16px; background: var(--card-bg); border: 1px solid var(--card-border); border-radius: var(--r-md); margin-bottom: 10px; flex-wrap: wrap;">' +
        '<div style="width: 72px; height: 72px; border-radius: var(--r-sm); overflow: hidden; background: var(--bg-800); flex-shrink: 0; display: flex; align-items: center; justify-content: center;">' + mediaHtml + '</div>' +
        '<div style="flex: 1; min-width: 200px;">' +
          '<div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px; flex-wrap: wrap;">' +
            statusBadge(item.status) +
            '<span style="font-family: var(--mono); font-size: 10.5px; color: var(--ink-faint);">' + escapeHtml(item.category || 'General') + '</span>' +
          '</div>' +
          '<div style="font-family: var(--display); font-weight: 600; font-size: 1rem; color: var(--ink); margin-bottom: 4px;">' + escapeHtml(item.title) + '</div>' +
          '<div style="font-family: var(--mono); font-size: 11px; color: var(--ink-muted);">' +
            '&#8358;' + Number(item.price).toLocaleString() + ' per ' + escapeHtml(item.unit) +
            ' &bull; ' + (item.views || 0) + ' views' +
          '</div>' +
        '</div>' +
        '<div style="display: flex; gap: 8px; flex-wrap: wrap;">' +
          '<a href="/products/' + item.id + '" class="btn btn-ghost" style="font-size: 12px; padding: 8px 14px;">View</a>' +
          '<a href="/dashboard/edit-listing/' + item.id + '" class="btn btn-ghost" style="font-size: 12px; padding: 8px 14px;">Edit</a>' +
          (item.status === 'active'
            ? '<button class="btn btn-ghost mark-sold-btn" data-id="' + item.id + '" style="font-size: 12px; padding: 8px 14px;">Mark Sold</button>' +
              '<button class="btn btn-ghost archive-btn" data-id="' + item.id + '" style="font-size: 12px; padding: 8px 14px; color: var(--red); border-color: var(--red);">Archive</button>'
            : '<button class="btn btn-ghost reactivate-btn" data-id="' + item.id + '" style="font-size: 12px; padding: 8px 14px;">Reactivate</button>') +
        '</div>' +
      '</div>';
    }).join('');

    container.innerHTML = html;

    // Wire up action buttons
    container.querySelectorAll('.mark-sold-btn').forEach(btn => {
      btn.addEventListener('click', () => updateStatus((btn as HTMLElement).dataset.id!, 'sold'));
    });
    container.querySelectorAll('.archive-btn').forEach(btn => {
      btn.addEventListener('click', () => updateStatus((btn as HTMLElement).dataset.id!, 'archived'));
    });
    container.querySelectorAll('.reactivate-btn').forEach(btn => {
      btn.addEventListener('click', () => updateStatus((btn as HTMLElement).dataset.id!, 'active'));
    });
  }

  async function updateStatus(id: string, status: string) {
    const { error } = await supabase.from('products').update({ status }).eq('id', id);
    if (error) {
      alert('Error: ' + error.message);
      return;
    }
    const item = allListings.find(l => String(l.id) === String(id));
    if (item) item.status = status;
    renderStats();
    render();
  }

  filterTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      filterTabs.forEach(t => {
        (t as HTMLElement).style.background = 'transparent';
        (t as HTMLElement).style.color = 'var(--ink-muted)';
      });
      (tab as HTMLElement).style.background = 'var(--cyan)';
      (tab as HTMLElement).style.color = 'var(--bg-950)';
      currentFilter = (tab as HTMLElement).dataset.filter || 'all';
      render();
    });
  });

  async function load() {
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) {
      container.innerHTML = '<p style="text-align: center; padding: 40px; color: var(--red); font-family: var(--mono); font-size: 13px;">You must be signed in. <a href="/login" style="color: var(--cyan);">Sign in</a></p>';
      loading.style.display = 'none';
      return;
    }

    const { data, error } = await supabase
      .from('products')
      .select('id, title, price, unit, category, status, views, media_urls, image_urls, created_at')
      .eq('seller_id', user.id)
      .order('created_at', { ascending: false });

    loading.style.display = 'none';

    if (error) {
      container.innerHTML = '<p style="text-align: center; padding: 40px; color: var(--red); font-family: var(--mono); font-size: 13px;">Error: ' + error.message + '</p>';
      return;
    }

    allListings = data || [];
    renderStats();
    render();
  }

  load();
</script>