---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

const { slug } = Astro.params;

const { data: article, error } = await supabase
  .from('qm_news')
  .select('*')
  .eq('slug', slug)
  .maybeSingle();

if (error || !article) {
  return Astro.redirect('/');
}

const publishedDate = new Date(article.published_at || article.created_at);
const dateStr = publishedDate.toLocaleDateString('en-NG', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const content = article.body || article.content_markdown || article.description || '';
const sourceName = article.source_name || 'News';
const sourceUrl = article.source_url || null;

// SEO
const pageDescription = (article.description || article.title || '').slice(0, 160);
const ogImage = 'https://qarayemarchants.com.ng/og-default.png';
---

<Layout title={article.title} description={pageDescription} ogImage={ogImage} ogType="article">
  <div class="container" style="padding: 40px 24px; max-width: 780px;">

    <a href="/" style="font-family: var(--mono); font-size: 12px; color: var(--ink-muted); text-decoration: none; display: inline-flex; align-items: center; gap: 6px; margin-bottom: 24px;">
      &larr; Back to feed
    </a>

    <article style="background: var(--bg-900); border: 1px solid var(--line-soft); border-radius: var(--r-lg); padding: 32px;">

      <header style="margin-bottom: 28px;">
        <span style="display: inline-block; font-family: var(--mono); font-size: 10.5px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--violet); background: var(--violet-soft); padding: 4px 12px; border-radius: var(--r-full); margin-bottom: 16px;">
          NEWS
        </span>

        <h1 style="font-family: var(--display); font-size: clamp(1.5rem, 4vw, 2.2rem); font-weight: 700; line-height: 1.25; margin: 0 0 16px 0; color: var(--ink);">
          {article.title}
        </h1>

        <div style="display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap; font-family: var(--mono); font-size: 12px; color: var(--ink-faint);">
          <span>Source: <strong style="color: var(--cyan); font-weight: 600;">{sourceName}</strong></span>
          <span style="width: 3px; height: 3px; border-radius: 50%; background: var(--ink-faint); display: inline-block;"></span>
          <time datetime={publishedDate.toISOString()}>{dateStr}</time>
        </div>
      </header>

      {article.description && (
        <p style="font-size: 1.1rem; line-height: 1.6; color: var(--ink-muted); margin: 0 0 24px 0; padding: 16px 20px; border-left: 3px solid var(--cyan); background: var(--cyan-soft); border-radius: var(--r-sm);">
          {article.description}
        </p>
      )}

      {content && (
        <div class="article-body" set:html={content.replace(/\n/g, '<br />')} />
      )}

      {sourceUrl && (
        <div style="margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--line-soft);">
          <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost" style="font-size: 13px; padding: 10px 20px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
            Read full article at {sourceName}
          </a>
        </div>
      )}

    </article>

  </div>
</Layout>

<style is:global>
  .article-body {
    font-size: 1.02rem;
    line-height: 1.85;
    color: var(--ink-muted);
    word-wrap: break-word;
  }
  .article-body a {
    color: var(--cyan);
    text-decoration: underline;
  }
  .article-body p {
    margin: 0 0 16px 0;
  }
  @media (max-width: 640px) {
    article {
      padding: 22px 18px !important;
    }
  }
</style>