---
import Layout from '../layouts/Layout.astro';
import { createSupabaseServerClient } from '../lib/auth';

const url = Astro.url;
const rawNext = url.searchParams.get('next') || '/';
const next = rawNext.startsWith('/') && !rawNext.startsWith('//') ? rawNext : '/';
const mode = url.searchParams.get('mode') === 'signup' ? 'signup' : 'login';

const authClient = createSupabaseServerClient(Astro.cookies);
const { data: { user } } = await authClient.auth.getUser();
if (user) {
  return Astro.redirect(next);
}
---

<Layout title="Sign In | Qaraye Marchants">
  <div class="auth-wrap">
    <div class="auth-card">

      <a href="/" class="auth-back">Back to feed</a>

      <div class="auth-header">
        <h1>{mode === 'signup' ? 'Create your account' : 'Sign in'}</h1>
        <p>{mode === 'signup' ? 'Join the community.' : 'Welcome back.'}</p>
      </div>

      <div class="auth-tabs">
        <a href="/login" class:list={['auth-tab', mode === 'login' && 'active']}>Sign in</a>
        <a href="/login?mode=signup" class:list={['auth-tab', mode === 'signup' && 'active']}>Sign up</a>
      </div>

      <form id="auth-form" data-mode={mode} data-next={next} novalidate>

        {mode === 'signup' && (
          <div class="form-field">
            <label for="display_name">Display name</label>
            <input type="text" id="display_name" required minlength="2" maxlength="60" placeholder="e.g. Ada Obi" />
          </div>
        )}

        <div class="form-field">
          <label for="email">Email</label>
          <input type="email" id="email" required placeholder="you@example.com" />
        </div>

        <div class="form-field">
          <label for="password">Password</label>
          <input type="password" id="password" required minlength="6" placeholder="At least 6 characters" />
        </div>

        <p class="auth-error" id="auth-error" hidden></p>

        <button type="submit" class="btn btn-primary auth-submit" id="auth-submit">
          {mode === 'signup' ? 'Create account' : 'Sign in'}
        </button>
      </form>

    </div>
  </div>
</Layout>

<style>
  .auth-wrap { padding: 60px 20px 80px; display: flex; justify-content: center; }
  .auth-card {
    width: 100%; max-width: 440px;
    background: var(--bg-900); border: 1px solid var(--line-soft);
    border-radius: var(--r-lg); padding: 32px;
  }
  .auth-back {
    display: inline-block; font-family: var(--mono); font-size: 12px;
    color: var(--ink-faint); text-decoration: none; margin-bottom: 20px;
  }
  .auth-back:hover { color: var(--cyan); }
  .auth-header { margin-bottom: 24px; }
  .auth-header h1 {
    font-family: var(--display); font-size: 1.5rem;
    font-weight: 700; color: var(--ink); margin: 0 0 8px;
  }
  .auth-header p { color: var(--ink-muted); font-size: 0.92rem; margin: 0; }

  .auth-tabs {
    display: flex; background: var(--bg-850); border: 1px solid var(--line-soft);
    border-radius: var(--r-md); padding: 4px; margin-bottom: 24px;
  }
  .auth-tab {
    flex: 1; text-align: center; padding: 9px;
    font-family: var(--mono); font-size: 12.5px; font-weight: 600;
    color: var(--ink-muted); border-radius: var(--r-sm);
    text-decoration: none; transition: 0.15s;
  }
  .auth-tab:hover { color: var(--ink); }
  .auth-tab.active { background: var(--cyan-soft); color: var(--cyan); }

  .form-field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 18px; }
  .form-field label {
    font-family: var(--mono); font-size: 11px; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--ink-muted);
  }
  .form-field input {
    background: var(--bg-850); border: 1px solid var(--line-soft);
    border-radius: var(--r-sm); color: var(--ink);
    font-family: var(--body); font-size: 15px; padding: 12px 14px;
    transition: border-color 0.15s;
  }
  .form-field input:focus { outline: none; border-color: var(--cyan); }
  .form-field input::placeholder { color: var(--ink-faint); }

  .auth-error {
    color: var(--red); background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: var(--r-sm); padding: 10px 14px;
    font-size: 0.88rem; margin: 0 0 16px;
  }
  .auth-submit { width: 100%; justify-content: center; padding: 13px; }
  .auth-submit:disabled { opacity: 0.6; cursor: wait; }
</style>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('auth-form') as HTMLFormElement;
  const submitBtn = document.getElementById('auth-submit') as HTMLButtonElement;
  const errorEl = document.getElementById('auth-error') as HTMLParagraphElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.hidden = true;

    const mode = form.dataset.mode!;
    const next = form.dataset.next || '/';
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('password') as HTMLInputElement).value;
    const displayNameInput = document.getElementById('display_name') as HTMLInputElement | null;
    const displayName = displayNameInput ? displayNameInput.value.trim() : '';

    submitBtn.disabled = true;
    submitBtn.textContent = mode === 'signup' ? 'Creating...' : 'Signing in...';

    if (mode === 'signup') {
      const { error } = await supabase.auth.signUp({
        email,
        password,
        options: { data: { display_name: displayName || email.split('@')[0] } },
      });
      if (error) {
        errorEl.textContent = error.message;
        errorEl.hidden = false;
        submitBtn.disabled = false;
        submitBtn.textContent = 'Create account';
        return;
      }
      window.location.href = next;
    } else {
      const { error } = await supabase.auth.signInWithPassword({ email, password });
      if (error) {
        errorEl.textContent = error.message;
        errorEl.hidden = false;
        submitBtn.disabled = false;
        submitBtn.textContent = 'Sign in';
        return;
      }
      window.location.href = next;
    }
  });
</script>