---
import { supabase } from '../lib/supabase';

const sixMonthsAgo = new Date();
sixMonthsAgo.setDate(sixMonthsAgo.getDate() - 180);

const { data: signals } = await supabase
  .from('qm_price_signals')
  .select('item_name, category, price, unit, recorded_at, source')
  .eq('status', 'approved')
  .gte('recorded_at', sixMonthsAgo.toISOString().slice(0, 10))
  .order('recorded_at', { ascending: true });

const byItem: Record<string, any[]> = {};
(signals || []).forEach((s) => {
  if (!byItem[s.item_name]) byItem[s.item_name] = [];
  byItem[s.item_name].push(s);
});

const series = Object.entries(byItem).map(([name, pts]) => {
  const first = Number(pts[0].price);
  const last = Number(pts[pts.length - 1].price);
  const changePct = first > 0 ? Math.round(((last - first) / first) * 100) : 0;
  return {
    name,
    unit: pts[0].unit,
    category: pts[0].category,
    points: pts.map((p) => ({ x: p.recorded_at, y: Number(p.price) })),
    changePct,
    last,
  };
})
.sort((a, b) => Math.abs(b.changePct) - Math.abs(a.changePct))
.slice(0, 6);

const hasData = series.length > 0;
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', day: 'numeric' });
const startDate = hasData && signals && signals[0] ? fmt(new Date(signals[0].recorded_at)) : '';
const endDate = hasData && signals && signals[signals.length - 1] ? fmt(new Date(signals[signals.length - 1].recorded_at)) : '';
const year = new Date().getFullYear();
---

<section class="harvest-section">
  <div class="harvest-title-row">
    <h2 class="harvest-title">
      <span data-i18n="harvestTitle">Harvest Season Price Trends</span>
      {hasData && <span class="harvest-range">({startDate} – {endDate} {year})</span>}
    </h2>
  </div>

  {!hasData ? (
    <div class="harvest-empty">
      <p data-i18n="harvestEmpty">Not enough price signals yet. Add data from the admin dashboard.</p>
      <a href="/admin/harvest-trends" class="harvest-cta" data-i18n="harvestManage">Manage price signals →</a>
    </div>
  ) : (
    <>
      <div class="harvest-legend" id="harvestLegend"></div>
      <div class="harvest-chart-wrap">
        <canvas id="harvestChart"></canvas>
      </div>
    </>
  )}
</section>

<script type="application/json" id="harvest-series-data" set:html={JSON.stringify(series)} />

<script>
  const seriesEl = document.getElementById('harvest-series-data');
  const series = seriesEl ? JSON.parse(seriesEl.textContent || '[]') : [];

  function boot() {
    const canvas = document.getElementById('harvestChart') as HTMLCanvasElement | null;
    if (!canvas) return;

    // Wait for Chart.js (loaded globally in Layout)
    if (typeof (window as any).Chart === 'undefined') {
      console.log('[HarvestChart] Waiting for Chart.js...');
      setTimeout(boot, 150);
      return;
    }
    const Chart = (window as any).Chart;

    console.log('[HarvestChart] Rendering with', series.length, 'series');

    const cssVar = (n: string) => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
    const inkFaint = cssVar('--ink-faint') || '#5a6485';
    const grid = 'rgba(255,255,255,0.05)';
    const palette = ['#8b5cf6', '#10d982', '#00e5ff', '#f59e0b', '#ef4444', '#ec4899'];

    const allDates = new Set<string>();
    series.forEach((s: any) => s.points.forEach((p: any) => allDates.add(p.x)));
    const labels = [...allDates].sort();

    const datasets = series.map((s: any, i: number) => {
      const map = new Map(s.points.map((p: any) => [p.x, p.y]));
      const data = labels.map(d => map.get(d) ?? null);
      return {
        label: `${s.name} (${s.changePct >= 0 ? '+' : ''}${s.changePct}%)`,
        data,
        borderColor: palette[i % palette.length],
        backgroundColor: palette[i % palette.length] + '15',
        tension: 0.3,
        borderWidth: 2,
        pointRadius: 3,
        pointHoverRadius: 6,
        pointBackgroundColor: palette[i % palette.length],
        pointBorderColor: '#05070f',
        pointBorderWidth: 2,
        spanGaps: true,
        fill: true,
      };
    });

    new Chart(canvas, {
      type: 'line',
      data: { labels, datasets },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: 'rgba(10,15,29,0.95)',
            borderColor: 'rgba(0,229,255,0.2)',
            borderWidth: 1,
            titleColor: '#f0f4ff',
            bodyColor: '#8b95b8',
            padding: 12,
            callbacks: {
              label: (c: any) => ` ${c.dataset.label.replace(/\s*\([+-]?\d+%\)$/, '')}: ₦${Number(c.raw).toLocaleString()}`,
            },
          },
        },
        scales: {
          x: {
            ticks: { color: inkFaint, font: { family: 'JetBrains Mono', size: 10 }, maxRotation: 0, autoSkipPadding: 20 },
            grid: { color: grid, drawTicks: false },
            border: { display: false },
          },
          y: {
            ticks: {
              color: inkFaint,
              font: { family: 'JetBrains Mono', size: 10 },
              callback: (v: any) => v >= 1000 ? '₦' + (v/1000).toFixed(1) + 'k' : '₦' + v,
            },
            grid: { color: grid, drawTicks: false },
            border: { display: false },
          },
        },
      },
    });

    // Custom legend
    const legendEl = document.getElementById('harvestLegend');
    if (legendEl) {
      legendEl.innerHTML = series.map((s: any, i: number) => {
        const color = palette[i % palette.length];
        const arrow = s.changePct >= 0 ? '▲' : '▼';
        const cls = s.changePct >= 0 ? 'up' : 'down';
        return `
          <div class="hl-item">
            <span class="hl-dot" style="background:${color};box-shadow:0 0 8px ${color}80;"></span>
            <span class="hl-name">${s.name}</span>
            <span class="hl-change ${cls}">${arrow} ${s.changePct >= 0 ? '+' : ''}${s.changePct}%</span>
          </div>
        `;
      }).join('');
    }

    console.log('[HarvestChart] Done.');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
</script>

<style>
  .harvest-section {
    max-width: 1280px;
    margin: 40px auto 32px;
    padding: 24px 24px 16px;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--r-lg);
    position: relative;
  }
  .harvest-title-row { text-align: center; margin-bottom: 18px; }
  .harvest-title {
    font-family: var(--display);
    font-size: 1.15rem;
    font-weight: 800;
    margin: 0;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .harvest-range {
    color: var(--ink-muted);
    font-weight: 500;
    font-size: 0.95rem;
    margin-left: 6px;
  }
  .harvest-legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px 24px;
    margin-bottom: 16px;
    padding: 12px 16px;
    background: var(--bg-850);
    border: 1px solid var(--line-soft);
    border-radius: var(--r-md);
  }
  .hl-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 11.5px;
  }
  .hl-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .hl-name { color: var(--ink); font-weight: 500; }
  .hl-change { font-weight: 700; padding: 2px 7px; border-radius: 4px; font-size: 10.5px; }
  .hl-change.up   { color: #10d982; background: rgba(16,217,130,0.12); }
  .hl-change.down { color: #ef4444; background: rgba(239,68,68,0.12); }
  .harvest-chart-wrap {
    position: relative;
    width: 100%;
    height: 340px;
  }
  .harvest-empty {
    text-align: center;
    padding: 40px 20px;
    color: var(--ink-muted);
    font-family: var(--body);
    font-size: 0.9rem;
    background: var(--bg-850);
    border: 1px dashed var(--line);
    border-radius: var(--r-md);
  }
  .harvest-cta {
    display: inline-block;
    margin-top: 12px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--cyan);
  }
  @media (max-width: 640px) {
    .harvest-section { padding: 16px; margin: 24px 16px; }
    .harvest-legend { gap: 10px 16px; }
    .hl-item { font-size: 10.5px; }
    .harvest-chart-wrap { height: 260px; }
  }
</style>