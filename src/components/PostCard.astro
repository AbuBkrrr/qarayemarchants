---
interface Props {
  type: 'community' | 'news';
  id: string;
  title: string;
  description?: string;
  thumbnailUrl?: string | null;
  mediaType?: 'image' | 'audio' | 'video' | 'none';
  authorName?: string;
  sourceName?: string;
  publishedAt: string;
  commentCount?: number;
  href: string;
}

const {
  type,
  title,
  description,
  thumbnailUrl,
  mediaType = 'none',
  authorName,
  sourceName,
  publishedAt,
  commentCount = 0,
  href,
} = Astro.props;

function timeAgo(iso: string): string {
  const diff = Date.now() - new Date(iso).getTime();
  const m = Math.floor(diff / 60000);
  if (m < 1) return 'just now';
  if (m < 60) return m + 'm ago';
  const h = Math.floor(m / 60);
  if (h < 24) return h + 'h ago';
  const d = Math.floor(h / 24);
  if (d < 7) return d + 'd ago';
  return new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
}
---

<a href={href} class:list={['qm-card', 'qm-card-' + type]}>
  {type === 'news' && (
    <div class="qm-card-media qm-card-media-tall">
      {thumbnailUrl ? (
        <img src={thumbnailUrl} alt={title} loading="lazy" decoding="async" />
      ) : (
        <div class="qm-news-gradient"></div>
      )}
      <span class="qm-badge qm-badge-news">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/></svg>
        <span data-i18n="tabNews">News</span>
      </span>
    </div>
  )}

  {type === 'community' && thumbnailUrl && (
    <div class="qm-card-media">
      <img src={thumbnailUrl} alt={title} loading="lazy" decoding="async" />
      <span class="qm-badge qm-badge-community">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        <span data-i18n="tabCommunity">Community</span>
      </span>
    </div>
  )}

  {type === 'community' && !thumbnailUrl && (
    <div class="qm-card-media qm-card-media-text">
      <span class="qm-badge qm-badge-community">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        <span data-i18n="tabCommunity">Community</span>
      </span>
    </div>
  )}

  <div class="qm-card-body">
    <h3>{title}</h3>
    {description && <p>{description}</p>}
    <div class="qm-card-meta">
      {type === 'community' && authorName && (
        <span class="qm-meta-author">by <b>{authorName}</b></span>
      )}
      {type === 'news' && sourceName && (
        <span class="qm-meta-source">{sourceName}</span>
      )}
      <span class="qm-meta-dot"></span>
      <span class="qm-meta-time">{timeAgo(publishedAt)}</span>
      <span class="qm-meta-spacer"></span>
      <span class="qm-meta-stat">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        {commentCount}
      </span>
    </div>
  </div>
</a>

<style>
  .qm-card {
    background: var(--bg-900);
    border: 1px solid var(--line-soft);
    border-radius: var(--r-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: 0.2s;
    text-decoration: none;
    color: inherit;
  }
  .qm-card:hover {
    border-color: var(--line);
    transform: translateY(-3px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 40px rgba(0, 229, 255, 0.08);
    opacity: 1;
  }
  .qm-card-media {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--bg-850);
    overflow: hidden;
  }
  .qm-card-media-tall { aspect-ratio: 16 / 7; }
  .qm-card-media-text { display: none; }
  .qm-card-media img { width: 100%; height: 100%; object-fit: cover; }
  .qm-news-gradient {
    width: 100%; height: 100%;
    background: linear-gradient(135deg, #0a0f1d 0%, #1c2540 50%, #0891a8 100%);
  }
  .qm-badge {
    position: absolute; top: 12px; left: 12px;
    display: inline-flex; align-items: center; gap: 5px;
    font-family: var(--mono); font-size: 10px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.06em;
    padding: 5px 10px; border-radius: var(--r-full);
    backdrop-filter: blur(10px);
  }
  .qm-badge-community {
    background: rgba(0, 229, 255, 0.2); color: var(--cyan);
    border: 1px solid rgba(0, 229, 255, 0.4);
  }
  .qm-badge-news {
    background: rgba(139, 92, 246, 0.2); color: var(--violet);
    border: 1px solid rgba(139, 92, 246, 0.4);
  }
  .qm-card-body {
    padding: 18px 20px 20px;
    display: flex; flex-direction: column; gap: 10px; flex: 1;
  }
  .qm-card-body h3 {
    font-family: var(--display); font-size: 1.08rem; font-weight: 600;
    color: var(--ink); margin: 0; line-height: 1.35; letter-spacing: -0.01em;
  }
  .qm-card-body p {
    color: var(--ink-muted); font-size: 0.88rem; line-height: 1.55;
    margin: 0; flex: 1;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .qm-card-meta {
    display: flex; align-items: center; gap: 8px;
    padding-top: 14px; margin-top: auto;
    border-top: 1px solid var(--line-soft);
    font-family: var(--mono); font-size: 11px; color: var(--ink-faint);
  }
  .qm-meta-author b { color: var(--ink-muted); font-weight: 600; }
  .qm-meta-source {
    color: var(--violet); text-transform: uppercase;
    letter-spacing: 0.05em; font-size: 10px;
  }
  .qm-meta-dot { width: 3px; height: 3px; border-radius: 50%; background: var(--ink-faint); }
  .qm-meta-spacer { flex: 1; }
  .qm-meta-stat { display: inline-flex; align-items: center; gap: 4px; color: var(--ink-muted); }
  .qm-meta-stat svg { width: 13px; height: 13px; }
</style>