---
export interface PostCardItem {
  type: 'community' | 'news';
  id: string;
  title: string;
  description: string;
  thumbnailUrl: string | null;
  mediaType: 'image' | 'audio' | 'video' | 'none';
  authorName?: string;
  sourceName?: string;
  publishedAt: string;
  commentCount: number;
  href: string;
}

interface Props {
  item: PostCardItem;
  layout?: 'card' | 'list';
}

const { item, layout = 'card' } = Astro.props;

function timeAgo(iso: string) {
  const s = Math.floor((Date.now() - new Date(iso).getTime()) / 1000);
  if (s < 60) return 'just now';
  if (s < 3600) return Math.floor(s / 60) + 'm ago';
  if (s < 86400) return Math.floor(s / 3600) + 'h ago';
  if (s < 604800) return Math.floor(s / 86400) + 'd ago';
  return new Date(iso).toLocaleDateString('en-NG', { day: 'numeric', month: 'short', year: 'numeric' });
}

const isCommunity = item.type === 'community';
const badgeLabel = isCommunity ? 'COMMUNITY' : 'NEWS';
---

<a href={item.href} class:list={['post-card', `layout-${layout}`]}>
  {layout === 'card' ? (
    <>
      {item.thumbnailUrl && item.mediaType !== 'none' && (
        <div class="pc-media">
          {item.mediaType === 'video' ? (
            <video src={item.thumbnailUrl} muted></video>
          ) : (
            <img src={item.thumbnailUrl} alt={item.title} loading="lazy" />
          )}
        </div>
      )}
      <div class="pc-body">
        <div class="pc-top">
          <span class:list={['pc-badge', isCommunity ? 'badge-community' : 'badge-news']}>
            {badgeLabel}
          </span>
          <span class="pc-time">{timeAgo(item.publishedAt)}</span>
        </div>
        <h3 class="pc-title">{item.title}</h3>
        {item.description && <p class="pc-desc">{item.description}</p>}
        <div class="pc-meta">
          <span class="pc-author">
            {isCommunity ? (item.authorName || 'Member') : (item.sourceName || 'Source')}
          </span>
          <span class="pc-comments">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            {item.commentCount || 0}
          </span>
        </div>
      </div>
    </>
  ) : (
    <>
      <div class="pc-list-media">
        {item.thumbnailUrl && item.mediaType !== 'none' ? (
          item.mediaType === 'video' ? (
            <video src={item.thumbnailUrl} muted></video>
          ) : (
            <img src={item.thumbnailUrl} alt={item.title} loading="lazy" />
          )
        ) : (
          <div class="pc-list-placeholder">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--ink-faint)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          </div>
        )}
      </div>
      <div class="pc-list-body">
        <div class="pc-top">
          <span class:list={['pc-badge', isCommunity ? 'badge-community' : 'badge-news']}>
            {badgeLabel}
          </span>
          <span class="pc-time">{timeAgo(item.publishedAt)}</span>
        </div>
        <h3 class="pc-title">{item.title}</h3>
        {item.description && <p class="pc-desc">{item.description}</p>}
        <div class="pc-meta">
          <span class="pc-author">
            {isCommunity ? (item.authorName || 'Member') : (item.sourceName || 'Source')}
          </span>
          <span class="pc-comments">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            {item.commentCount || 0}
          </span>
        </div>
      </div>
    </>
  )}
</a>

<style is:global>
  .post-card {
    text-decoration: none;
    display: block;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--r-lg);
    overflow: hidden;
    transition: transform 0.15s, border-color 0.15s, box-shadow 0.15s;
    color: inherit;
  }
  .post-card:hover {
    transform: translateY(-2px);
    border-color: var(--cyan);
    box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    opacity: 1;
  }

  /* CARD LAYOUT */
  .post-card.layout-card {
    display: flex;
    flex-direction: column;
  }
  .layout-card .pc-media {
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 200px;
    overflow: hidden;
    background: var(--bg-800);
    border-bottom: 1px solid var(--line-soft);
  }
  .layout-card .pc-media img,
  .layout-card .pc-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .layout-card .pc-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* LIST LAYOUT */
  .post-card.layout-list {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    gap: 0;
  }
  .layout-list .pc-list-media {
    width: 160px;
    min-width: 160px;
    height: 120px;
    background: var(--bg-800);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-right: 1px solid var(--line-soft);
  }
  .layout-list .pc-list-media img,
  .layout-list .pc-list-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .layout-list .pc-list-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .layout-list .pc-list-body {
    flex: 1;
    min-width: 0;
    padding: 18px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    justify-content: center;
  }

  /* SHARED ELEMENTS */
  .pc-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }
  .pc-badge {
    font-family: var(--mono);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 3px 8px;
    border-radius: var(--r-full);
  }
  .badge-community {
    background: var(--cyan-soft);
    color: var(--cyan);
  }
  .badge-news {
    background: var(--violet-soft);
    color: var(--violet);
  }
  .pc-time {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--ink-faint);
    white-space: nowrap;
  }
  .pc-title {
    font-family: var(--display);
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    color: var(--ink);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pc-desc {
    font-size: 0.85rem;
    color: var(--ink-muted);
    margin: 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .layout-list .pc-desc {
    -webkit-line-clamp: 1;
  }
  .pc-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 8px;
    border-top: 1px solid var(--line-soft);
  }
  .pc-author {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--ink-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pc-comments {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--ink-faint);
    flex-shrink: 0;
  }

  @media (max-width: 500px) {
    .layout-list .pc-list-media {
      width: 100px;
      min-width: 100px;
      height: 90px;
    }
  }
</style>