---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Qaraye Marchants - The pulse of Nigerian finance',
  description = 'Read today\u2019s Nigerian financial news, share your insights, and discuss what matters with the community.',
} = Astro.props;

const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
  <style is:global>
    /* ============ THEME VARIABLES ============ */
    :root, [data-theme="dark"] {
      --bg-950: #05070f; --bg-900: #0a0f1d; --bg-850: #0f1526; --bg-800: #141b30; --bg-700: #1c2540;
      --cyan: #00e5ff; --cyan-soft: rgba(0, 229, 255, 0.12); --cyan-dim: #0891a8;
      --violet: #8b5cf6; --violet-soft: rgba(139, 92, 246, 0.12);
      --ink: #f0f4ff; --ink-muted: #8b95b8; --ink-faint: #5a6485;
      --line: rgba(0, 229, 255, 0.16); --line-soft: rgba(255, 255, 255, 0.06); --line-strong: rgba(0, 229, 255, 0.32);
      --nav-bg: rgba(5, 7, 15, 0.85); --nav-border: rgba(255, 255, 255, 0.06);
      --card-bg: #0a0f1d; --card-border: rgba(0, 229, 255, 0.16);
      --display: 'Outfit', system-ui, sans-serif; --body: 'Inter', system-ui, sans-serif; --mono: 'JetBrains Mono', monospace;
      --r-sm: 8px; --r-md: 12px; --r-lg: 18px; --r-xl: 24px; --r-full: 999px;
      --green: #10d982; --red: #ef4444; --amber: #f59e0b;
    }
    [data-theme="harvest"] {
      --bg-950: #F9F6F0; --bg-900: #F0ECE1; --bg-850: #EAE4D8; --bg-800: #E0D8C8; --bg-700: #D4C9B4;
      --cyan: #2E5A3B; --cyan-soft: rgba(46, 90, 59, 0.1); --cyan-dim: #1E3E28;
      --violet: #8B5A2B; --violet-soft: rgba(139, 90, 43, 0.1);
      --ink: #2C2C2C; --ink-muted: #6B6B6B; --ink-faint: #9CA3AF;
      --line: rgba(46, 90, 59, 0.15); --line-soft: rgba(46, 90, 59, 0.08); --line-strong: rgba(46, 90, 59, 0.3);
      --nav-bg: rgba(249, 246, 240, 0.9); --nav-border: rgba(46, 90, 59, 0.1);
      --card-bg: #FFFFFF; --card-border: rgba(139, 90, 43, 0.15);
    }
    [data-theme="merchant"] {
      --bg-950: #1A1F2B; --bg-900: #232B3B; --bg-850: #2A344A; --bg-800: #33405A; --bg-700: #3D4C6B;
      --cyan: #D4A017; --cyan-soft: rgba(212, 160, 23, 0.12); --cyan-dim: #B88A14;
      --violet: #C27A3E; --violet-soft: rgba(194, 122, 62, 0.12);
      --ink: #F4F0E6; --ink-muted: #9CA3AF; --ink-faint: #6B7280;
      --line: rgba(212, 160, 23, 0.2); --line-soft: rgba(255, 255, 255, 0.06); --line-strong: rgba(212, 160, 23, 0.4);
      --nav-bg: rgba(26, 31, 43, 0.9); --nav-border: rgba(212, 160, 23, 0.15);
      --card-bg: #232B3B; --card-border: rgba(212, 160, 23, 0.15);
    }
    [data-theme="sackcloth"] {
      --bg-950: #F4EFE6; --bg-900: #EAE2D5; --bg-850: #DFD5C3; --bg-800: #D3C7B1; --bg-700: #C7B89F;
      --cyan: #4A5D23; --cyan-soft: rgba(74, 93, 35, 0.1); --cyan-dim: #3A4A1B;
      --violet: #7B5B3A; --violet-soft: rgba(123, 91, 58, 0.1);
      --ink: #332B25; --ink-muted: #7A6F65; --ink-faint: #A69A8E;
      --line: rgba(74, 93, 35, 0.15); --line-soft: rgba(74, 93, 35, 0.08); --line-strong: rgba(74, 93, 35, 0.3);
      --nav-bg: rgba(244, 239, 230, 0.9); --nav-border: rgba(74, 93, 35, 0.1);
      --card-bg: #FFFFFF; --card-border: rgba(123, 91, 58, 0.15);
    }
    [data-theme="emerald"] {
      --bg-950: #071A17; --bg-900: #0A2B28; --bg-850: #113B37; --bg-800: #16423C; --bg-700: #1E4D48;
      --cyan: #10B981; --cyan-soft: rgba(16, 185, 129, 0.15); --cyan-dim: #059669;
      --violet: #8B5CF6; --violet-soft: rgba(139, 92, 246, 0.15);
      --ink: #F0FDF4; --ink-muted: #86AFA5; --ink-faint: #4B6B66;
      --line: rgba(16, 185, 129, 0.2); --line-soft: rgba(16, 185, 129, 0.08); --line-strong: rgba(16, 185, 129, 0.4);
      --nav-bg: rgba(7, 26, 23, 0.85); --nav-border: rgba(16, 185, 129, 0.15);
      --card-bg: #0A2B28; --card-border: rgba(16, 185, 129, 0.2);
    }

    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      background: var(--bg-950); color: var(--ink); font-family: var(--body);
      min-height: 100vh; -webkit-font-smoothing: antialiased; line-height: 1.6; overflow-x: hidden;
      transition: background 0.3s ease, color 0.3s ease;
    }
    body::before {
      content: ""; position: fixed; inset: 0;
      background-image:
        repeating-linear-gradient(0deg, var(--line-soft) 0 1px, transparent 1px 48px),
        repeating-linear-gradient(90deg, var(--line-soft) 0 1px, transparent 1px 48px);
      pointer-events: none; z-index: 0;
      mask-image: radial-gradient(ellipse at center, black 0%, transparent 80%);
      -webkit-mask-image: radial-gradient(ellipse at center, black 0%, transparent 80%);
    }
    body::after {
      content: ""; position: fixed; inset: 0;
      background:
        radial-gradient(circle at 15% 15%, var(--cyan-soft) 0%, transparent 40%),
        radial-gradient(circle at 85% 25%, var(--violet-soft) 0%, transparent 40%);
      pointer-events: none; z-index: 0;
    }
    a { color: var(--cyan); text-decoration: none; }
    a:hover { opacity: 0.85; }
    img { max-width: 100%; height: auto; display: block; }
    .container { max-width: 1280px; margin: 0 auto; padding: 0 24px; position: relative; z-index: 1; }

    /* Disclaimer Banner */
    .disclaimer-banner {
      background: var(--cyan-soft); border-bottom: 1px solid var(--line);
      padding: 10px 24px; font-family: var(--mono); font-size: 11.5px;
      color: var(--ink-muted); text-align: center; position: relative; z-index: 99;
      display: flex; align-items: center; justify-content: center; gap: 12px; flex-wrap: wrap;
    }
    .disclaimer-banner a { color: var(--cyan); }
    .disclaimer-dismiss {
      background: transparent; border: 1px solid var(--line); color: var(--ink-muted);
      padding: 2px 10px; border-radius: var(--r-full); cursor: pointer;
      font-family: var(--mono); font-size: 10.5px;
    }
    .disclaimer-dismiss:hover { border-color: var(--cyan); color: var(--cyan); }

    /* NAV */
    .global-nav {
      position: sticky; top: 0; z-index: 100; background: var(--nav-bg);
      backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--nav-border); transition: background 0.3s ease;
    }
    .gn-inner {
      max-width: 1280px; margin: 0 auto; display: flex; align-items: center;
      gap: 20px; padding: 14px 24px;
    }
    .gn-logo {
      font-family: var(--display); font-weight: 800; font-size: 20px;
      letter-spacing: -0.02em; color: var(--ink); display: flex; align-items: center;
      gap: 8px; flex-shrink: 0;
    }
    .gn-logo-mark {
      width: 32px; height: 32px; border-radius: 10px;
      background: linear-gradient(135deg, var(--cyan), var(--violet));
      display: flex; align-items: center; justify-content: center;
      color: var(--bg-950); font-weight: 900; font-size: 16px;
      box-shadow: 0 0 20px var(--cyan-soft);
    }
    .gn-logo-text span { color: var(--cyan); }
    .gn-links {
      display: flex; gap: 4px; flex: 1; overflow-x: auto;
      scrollbar-width: none; -ms-overflow-style: none;
    }
    .gn-links::-webkit-scrollbar { display: none; }
    .gn-link {
      display: flex; align-items: center; gap: 6px; white-space: nowrap;
      font-family: var(--mono); font-size: 12px; font-weight: 500;
      color: var(--ink-muted); padding: 8px 14px; border-radius: var(--r-full);
      border: 1px solid transparent; transition: 0.15s;
    }
    .gn-link:hover { color: var(--ink); background: var(--bg-850); opacity: 1; }
    .gn-link.active { color: var(--cyan); background: var(--cyan-soft); border-color: var(--line); }
    .gn-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }

    /* Profile Dropdown */
    .user-menu { position: relative; display: none; }
    .user-avatar {
      width: 36px; height: 36px; border-radius: 50%;
      background: linear-gradient(135deg, var(--cyan), var(--violet));
      display: flex; align-items: center; justify-content: center;
      color: var(--bg-950); font-family: var(--display); font-weight: 800;
      font-size: 14px; cursor: pointer; border: 2px solid var(--line);
    }
    .user-dropdown {
      position: absolute; top: calc(100% + 8px); right: 0; min-width: 200px;
      background: var(--bg-900); border: 1px solid var(--line);
      border-radius: var(--r-md); box-shadow: 0 20px 40px rgba(0,0,0,0.4);
      padding: 6px; display: none; z-index: 200;
    }
    .user-dropdown.open { display: block; }
    .user-dropdown a, .user-dropdown button {
      display: flex; align-items: center; gap: 10px; width: 100%;
      padding: 10px 14px; font-family: var(--body); font-size: 13.5px;
      color: var(--ink-muted); border-radius: var(--r-sm); cursor: pointer;
      background: transparent; border: none; text-align: left;
    }
    .user-dropdown a:hover, .user-dropdown button:hover {
      background: var(--bg-850); color: var(--ink);
    }
    .user-dropdown .divider {
      height: 1px; background: var(--line-soft); margin: 4px 0;
    }

    .theme-btn, .lang-btn {
      display: flex; align-items: center; gap: 6px;
      background: var(--bg-850); border: 1px solid var(--line-soft);
      color: var(--ink-muted); font-family: var(--mono); font-size: 11.5px;
      font-weight: 500; padding: 8px 12px; border-radius: var(--r-full);
      cursor: pointer; transition: 0.15s;
    }
    .theme-btn:hover, .lang-btn:hover { color: var(--ink); border-color: var(--line); }
    .theme-btn svg, .lang-btn svg { width: 14px; height: 14px; }
    .lang-switcher { position: relative; }
    .lang-dropdown {
      position: absolute; top: calc(100% + 8px); right: 0; min-width: 180px;
      background: var(--bg-900); border: 1px solid var(--line);
      border-radius: var(--r-md); box-shadow: 0 20px 40px rgba(0,0,0,0.3);
      padding: 6px; display: none; z-index: 200;
    }
    .lang-dropdown.open { display: block; }
    .lang-option {
      display: flex; align-items: center; justify-content: space-between;
      gap: 12px; padding: 10px 14px; font-family: var(--body);
      font-size: 13.5px; color: var(--ink-muted); border-radius: var(--r-sm);
      cursor: pointer; transition: 0.12s;
    }
    .lang-option:hover { background: var(--bg-850); color: var(--ink); }
    .lang-option.active { color: var(--cyan); background: var(--cyan-soft); }
    .lang-option-code {
      font-family: var(--mono); font-size: 10.5px; text-transform: uppercase;
      color: var(--ink-faint); letter-spacing: 0.08em;
    }
    .lang-option.active .lang-option-code { color: var(--cyan); }

    .btn {
      display: inline-flex; align-items: center; justify-content: center;
      gap: 8px; font-family: var(--body); font-size: 13.5px; font-weight: 600;
      padding: 10px 20px; border-radius: var(--r-full); cursor: pointer;
      border: 1px solid transparent; transition: all 0.15s; white-space: nowrap;
    }
    .btn svg { width: 15px; height: 15px; flex-shrink: 0; }
    .btn-primary {
      background: linear-gradient(135deg, var(--cyan), var(--violet));
      color: var(--bg-950); box-shadow: 0 0 20px var(--cyan-soft);
    }
    .btn-primary:hover { opacity: 1; transform: translateY(-1px); box-shadow: 0 0 30px var(--cyan-soft); }
    .btn-ghost { background: transparent; border-color: var(--line); color: var(--ink-muted); }
    .btn-ghost:hover { color: var(--ink); border-color: var(--cyan); background: var(--cyan-soft); opacity: 1; }

    .site-footer {
      border-top: 1px solid var(--line-soft); padding: 40px 0 30px;
      margin-top: 80px; position: relative; z-index: 1;
    }
    .site-footer .footer-inner {
      max-width: 1280px; margin: 0 auto; padding: 0 24px;
      display: flex; flex-wrap: wrap; justify-content: space-between;
      gap: 16px; color: var(--ink-muted); font-size: 0.85rem;
    }
    .footer-links {
      display: flex; flex-wrap: wrap; gap: 8px 24px;
      font-family: var(--mono); font-size: 12px;
    }
    .footer-links a { color: var(--ink-muted); }
    .footer-links a:hover { color: var(--cyan); }

    @media (max-width: 900px) {
      .gn-links .gn-text { display: none; }
      .gn-link { padding: 8px 10px; }
      .gn-logo-text { display: none; }
      .gn-inner { gap: 12px; padding: 12px 16px; }
    }
    @media (max-width: 640px) {
      .gn-actions .btn span { display: none; }
      .gn-actions .btn { padding: 10px 14px; }
      .theme-btn span, .lang-btn span { display: none; }
      .theme-btn, .lang-btn { padding: 8px 10px; }
    }
  </style>
</head>
<body>
  <!-- Disclaimer Banner -->
  <div class="disclaimer-banner" id="disclaimer-banner" style="display:none;">
    <span><strong>Disclaimer:</strong> Qaraye Marchants is a discovery platform. We do not handle payments or guarantee transactions. Buyers must verify products and sellers before purchase. <a href="/terms">Read More</a></span>
    <button class="disclaimer-dismiss" id="disclaimer-dismiss">Dismiss</button>
  </div>

  <header class="global-nav">
    <div class="gn-inner">
      <a href="/" class="gn-logo">
        <span class="gn-logo-mark">Q</span>
        <span class="gn-logo-text">QARAYE<span>MARCHANTS</span></span>
      </a>

      <nav class="gn-links" aria-label="Primary">
        <a href="/" class="gn-link active">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/></svg>
          <span class="gn-text">News</span>
        </a>
        <a href="/trending" class="gn-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
          <span class="gn-text">Trending</span>
        </a>
        <a href="/products" class="gn-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
          <span class="gn-text">Products</span>
        </a>
        <a href="/community" class="gn-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
          <span class="gn-text">Community</span>
        </a>
      </nav>

      <div class="gn-actions">
        <button class="theme-btn" id="theme-btn" aria-label="Change theme">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg>
          <span id="theme-label">Theme</span>
        </button>

        <div class="lang-switcher">
          <button class="lang-btn" id="lang-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            <span id="lang-label">English</span>
          </button>
          <div class="lang-dropdown" id="lang-dropdown">
            <div class="lang-option" data-lang-option="en"><span>English</span><span class="lang-option-code">EN</span></div>
            <div class="lang-option" data-lang-option="ha"><span>Hausa</span><span class="lang-option-code">HA</span></div>
            <div class="lang-option" data-lang-option="yo"><span>Yoruba</span><span class="lang-option-code">YO</span></div>
            <div class="lang-option" data-lang-option="ig"><span>Igbo</span><span class="lang-option-code">IG</span></div>
          </div>
        </div>

        <!-- Logged out state -->
        <div id="auth-buttons" style="display: flex; align-items: center; gap: 8px;">
          <a href="/login" class="btn btn-ghost">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
            <span>Sign In</span>
          </a>
          <a href="/create" class="btn btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>Create Post</span>
          </a>
        </div>

        <!-- Logged in state -->
        <div class="user-menu" id="user-menu">
          <div class="user-avatar" id="user-avatar">U</div>
          <div class="user-dropdown" id="user-dropdown">
            <a href="/dashboard/profile">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              My Profile
            </a>
            <a href="/dashboard/create-listing">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              New Listing
            </a>
            <a href="/dashboard/listings">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
              My Listings
            </a>
            <div class="divider"></div>
            <button id="signout-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              Sign Out
            </button>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div>&copy; {year} <a href="/">Qaraye Marchants</a></div>
      <div class="footer-links">
        <a href="/about">About</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/contact">Contact</a>
      </div>
    </div>
  </footer>

  <script>
    import { supabase } from '../lib/supabase';

    // Disclaimer banner
    const banner = document.getElementById('disclaimer-banner');
    const dismissBtn = document.getElementById('disclaimer-dismiss');
    if (banner && !localStorage.getItem('qm-disclaimer-dismissed')) {
      banner.style.display = 'flex';
    }
    dismissBtn?.addEventListener('click', () => {
      localStorage.setItem('qm-disclaimer-dismissed', '1');
      if (banner) banner.style.display = 'none';
    });

    // Theme toggle
    const themeBtn = document.getElementById('theme-btn');
    const themeLabel = document.getElementById('theme-label');
    const themes = ['dark', 'harvest', 'merchant', 'sackcloth', 'emerald'];
    const themeNames: Record<string, string> = {
      dark: 'Dark', harvest: 'Harvest', merchant: 'Merchant', sackcloth: 'Sackcloth', emerald: 'Emerald'
    };
    const savedTheme = localStorage.getItem('qm-theme') || 'dark';
    document.documentElement.setAttribute('data-theme', savedTheme);
    if (themeLabel) themeLabel.textContent = themeNames[savedTheme];
    themeBtn?.addEventListener('click', () => {
      const cur = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = themes[(themes.indexOf(cur) + 1) % themes.length];
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('qm-theme', next);
      if (themeLabel) themeLabel.textContent = themeNames[next];
    });

    // Language dropdown
    const langBtn = document.getElementById('lang-btn');
    const langDropdown = document.getElementById('lang-dropdown');
    langBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      langDropdown?.classList.toggle('open');
    });
    document.addEventListener('click', () => langDropdown?.classList.remove('open'));

    // Auth state
    const authButtons = document.getElementById('auth-buttons');
    const userMenu = document.getElementById('user-menu');
    const userAvatar = document.getElementById('user-avatar');
    const userDropdown = document.getElementById('user-dropdown');

    userAvatar?.addEventListener('click', (e) => {
      e.stopPropagation();
      userDropdown?.classList.toggle('open');
    });
    document.addEventListener('click', () => userDropdown?.classList.remove('open'));

    document.getElementById('signout-btn')?.addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = '/';
    });

    async function updateAuthUI() {
      const { data: { user } } = await supabase.auth.getUser();
      if (user && authButtons && userMenu) {
        authButtons.style.display = 'none';
        userMenu.style.display = 'block';
        const { data: profile } = await supabase.from('profiles').select('business_name, owner_name').eq('id', user.id).single();
        const name = profile?.business_name || profile?.owner_name || user.email || 'U';
        if (userAvatar) userAvatar.textContent = name.charAt(0).toUpperCase();
      } else if (authButtons && userMenu) {
        authButtons.style.display = 'flex';
        userMenu.style.display = 'none';
      }
    }

    updateAuthUI();
    supabase.auth.onAuthStateChange(() => updateAuthUI());
  </script>
</body>
</html>